<div class="min-h-screen bg-surface pb-20" data-controller="cruise-search">
  <!-- Header with Route Dropdown -->
  <div class="sticky top-0 z-20 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 py-3">
      <div class="flex items-center gap-3">
        <%= link_to cruises_path, class: "text-gray-700" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
        
        <!-- Route Selector Dropdown -->
        <div class="flex-1 flex items-center justify-center">
          <button class="flex items-center gap-2 text-lg font-semibold text-gray-900" data-action="click->cruise-search#toggleRouteDropdown">
            <% if @selected_route.present? %>
              <%= @selected_route.name %>航线
            <% else %>
              选择航线
            <% end %>
            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
        </div>

        <!-- Right Icons -->
        <div class="flex items-center gap-2">
          <button class="p-2 text-gray-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
            </svg>
          </button>
          <button class="p-2 text-gray-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Route Dropdown Panel -->
      <div class="hidden absolute top-full left-0 right-0 bg-white border-b border-gray-200 shadow-lg" data-cruise-search-target="routeDropdown">
        <div class="max-w-7xl mx-auto px-4 py-4">
          <div class="grid grid-cols-5 gap-3">
            <% @cruise_routes.each do |route| %>
              <% is_selected = @selected_route&.id == route.id %>
              <%= link_to search_cruises_path(route: route.id, cruise_line_id: params[:cruise_line_id], city: params[:city], month: params[:month]), class: "flex flex-col items-center gap-2 p-3 rounded-lg transition #{is_selected ? 'bg-primary/10 border-2 border-primary' : 'hover:bg-gray-50'}" do %>
                <% if route.icon_url.present? %>
                  <%= image_tag route.icon_url, alt: route.name, class: "w-12 h-12 object-contain" %>
                <% else %>
                  <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                  </div>
                <% end %>
                <span class="text-sm text-center <%= is_selected ? 'text-primary font-semibold' : 'text-gray-700' %>"><%= route.name %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if @sailings.any? %>
    <% 
      # 获取第一个班次作为默认展示
      first_sailing = @sailings.first
      cruise_ship = first_sailing.cruise_ship
      cruise_line = cruise_ship.cruise_line
    %>
    
    <!-- Cruise Line Selector (Horizontal Scroll) -->
    <section class="bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <div class="flex gap-3 overflow-x-auto pb-2">
          <% 
            # 获取该航线下的所有邮轮公司（基于当前筛选条件前的班次）
            base_sailings = CruiseSailing.where(status: 'on_sale')
            base_sailings = base_sailings.where(cruise_route_id: @selected_route.id) if @selected_route.present?
            all_cruise_lines = base_sailings.includes(:cruise_ship).map { |s| s.cruise_ship.cruise_line }.uniq
            
            # 如果没有选择邮轮公司，默认选中第一个
            default_cruise_line_id = all_cruise_lines.first&.id
            selected_cruise_line_id = params[:cruise_line_id].present? ? params[:cruise_line_id].to_i : default_cruise_line_id
            
            all_cruise_lines.each do |line|
              is_selected = selected_cruise_line_id == line.id
          %>
            <%= link_to search_cruises_path(route: params[:route], cruise_line_id: line.id, city: params[:city], month: params[:month]), 
                        class: "flex-none flex flex-col items-center gap-2 p-3 rounded-lg border-2 transition #{is_selected ? 'border-yellow-400 bg-yellow-50' : 'border-gray-200 hover:border-gray-300'}" do %>
              <% if line.logo_url.present? %>
                <%= image_tag line.logo_url, alt: line.name, class: "w-16 h-16 object-contain" %>
              <% else %>
                <div class="w-16 h-16 rounded-lg bg-gray-100 flex items-center justify-center">
                  <span class="text-2xl">🚢</span>
                </div>
              <% end %>
              <span class="text-xs text-center whitespace-nowrap <%= is_selected ? 'text-yellow-700 font-semibold' : 'text-gray-700' %>"><%= line.name %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>

    <!-- Cruise Ship Card (Dynamic for each sailing) -->
    <% @sailings.order(departure_date: :asc).each_with_index do |sailing, sailing_index| %>
      <% cruise_ship = sailing.cruise_ship %>
      <% cruise_line = cruise_ship.cruise_line %>
      <section class="bg-white <%= sailing_index == 0 ? '' : 'hidden' %>" 
               data-cruise-search-target="shipCard"
               data-sailing-id="<%= sailing.id %>">
        <div class="max-w-7xl mx-auto">
          <!-- Ship Image with Background -->
          <div class="relative h-56 bg-gradient-to-br from-blue-400 to-blue-600">
            <% if cruise_ship.image_url.present? %>
              <%= image_tag cruise_ship.image_url, alt: cruise_ship.name, class: "w-full h-full object-cover mix-blend-overlay opacity-80" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center">
                <svg class="w-20 h-20 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            <% end %>
            
            <!-- Ship Info Overlay -->
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4">
              <div class="flex items-end justify-between">
                <div>
                  <h2 class="text-2xl font-bold text-white mb-1"><%= cruise_ship.name %></h2>
                  <p class="text-white/90 text-sm"><%= cruise_ship.name_en %></p>
                </div>
                <% if cruise_line.logo_url.present? %>
                  <div class="bg-white rounded-lg p-2">
                    <%= image_tag cruise_line.logo_url, alt: cruise_line.name, class: "h-8 object-contain" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>


        </div>
      </section>
    <% end %>

    <!-- Departure City & Month Selector (Yellow Background) -->
    <section class="bg-yellow-50 border-b border-yellow-100">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <div class="flex items-center gap-4">
          <!-- Departure City -->
          <div class="flex-1 relative">
            <button class="w-full flex items-center justify-between px-4 py-3 bg-white rounded-lg border border-gray-200 hover:border-yellow-400 transition"
                    data-action="click->cruise-search#toggleCityDropdown">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <div class="text-left">
                  <div class="text-xs text-gray-500">筛选登船城市</div>
                  <div class="text-sm font-medium text-gray-900">
                    <%= params[:city].presence || '全部城市' %>
                  </div>
                </div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            
            <!-- City Dropdown Panel -->
            <div class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-lg shadow-lg border border-gray-200 z-20"
                 data-cruise-search-target="cityDropdown">
              <div class="p-3 max-h-64 overflow-y-auto">
                <%= link_to '全部城市', search_cruises_path(route: params[:route], cruise_line_id: params[:cruise_line_id], month: params[:month]), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-yellow-50 rounded transition' %>
                
                <% @all_departure_cities.each do |city| %>
                  <%= link_to city, search_cruises_path(route: params[:route], cruise_line_id: params[:cruise_line_id], city: city, month: params[:month]), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-yellow-50 rounded transition' %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Departure Month -->
          <div class="flex-1 relative">
            <button class="w-full flex items-center justify-between px-4 py-3 bg-white rounded-lg border border-gray-200 hover:border-yellow-400 transition"
                    data-action="click->cruise-search#toggleMonthDropdown">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <div class="text-left">
                  <div class="text-xs text-gray-500">筛选出发月份</div>
                  <div class="text-sm font-medium text-gray-900">
                    <% if params[:month].present? %>
                      <%= Date.parse("#{params[:month]}-01").strftime('%Y年%m月') %>
                    <% else %>
                      全部月份
                    <% end %>
                  </div>
                </div>
              </div>
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            
            <!-- Month Dropdown Panel -->
            <div class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-lg shadow-lg border border-gray-200 z-20"
                 data-cruise-search-target="monthDropdown">
              <div class="p-3 max-h-64 overflow-y-auto">
                <%= link_to '全部月份', search_cruises_path(route: params[:route], cruise_line_id: params[:cruise_line_id], city: params[:city]), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-yellow-50 rounded transition' %>
                
                <% @all_departure_months.each do |month| %>
                  <% month_date = Date.parse("#{month}-01") %>
                  <%= link_to month_date.strftime('%Y年%m月'), search_cruises_path(route: params[:route], cruise_line_id: params[:cruise_line_id], city: params[:city], month: month), class: 'block px-4 py-2 text-sm text-gray-700 hover:bg-yellow-50 rounded transition' %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sailing Dates List -->
    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <h3 class="text-sm font-medium text-gray-500 mb-3">选择出行日期</h3>
        <div class="space-y-3">
          <% @sailings.order(departure_date: :asc).each_with_index do |sailing, index| %>
            <% is_date_selected = params[:sailing_id].present? ? params[:sailing_id].to_i == sailing.id : (index == 0) %>
            <div class="relative flex items-center justify-between p-4 rounded-lg border-2 hover:shadow-sm transition cursor-pointer <%= is_date_selected ? 'bg-yellow-50 border-yellow-400' : 'bg-white border-gray-200' %>"
                 data-action="click->cruise-search#selectDate"
                 data-sailing-id="<%= sailing.id %>"
                 data-cruise-search-target="dateCard">
              
              <!-- Date Info -->
              <div class="flex-1">
                <div class="flex items-baseline gap-2 mb-1">
                  <span class="text-base font-semibold text-gray-900">
                    <%= sailing.departure_date.strftime('%m月%d日') %> 出发
                  </span>
                  <span class="text-sm text-gray-500">| <%= sailing.departure_port %></span>
                </div>
                <div class="flex items-center gap-4 text-sm text-gray-600">
                  <div class="flex items-center gap-1">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span><%= sailing.cruise_route.name %>航线 · <%= sailing.duration_days %>天<%= sailing.duration_nights %>晚</span>
                  </div>
                  <div class="flex items-center gap-1">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    </svg>
                    <span><%= sailing.departure_port %> - <%= sailing.arrival_port %></span>
                  </div>
                </div>
              </div>

              <!-- Check Button -->
              <button type="button" 
                      class="flex-none ml-4 px-4 py-2 bg-yellow-400 text-gray-900 text-sm font-medium rounded-full hover:bg-yellow-500 transition flex items-center gap-1 relative z-10"
                      data-action="click->cruise-search#openItineraryModal"
                      data-sailing-id="<%= sailing.id %>">
                查看行程
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <!-- Cabin Selection -->
    <section class="bg-surface pt-4 pb-8">
      <div class="max-w-7xl mx-auto px-4">
        <h3 class="text-base font-semibold text-gray-900 mb-4">选择舱房</h3>
        
        <% @sailings.order(departure_date: :asc).each_with_index do |sailing, sailing_index| %>
          <div class="<%= sailing_index == 0 ? '' : 'hidden' %> flex gap-3 overflow-x-auto pb-2"
               data-cruise-search-target="cabinContainer"
               data-sailing-id="<%= sailing.id %>">
            <% 
              # 获取该航次的邮轮的舱房类型
              cruise_ship = sailing.cruise_ship
              cabin_types = cruise_ship.cabin_types.sort_by { |ct| ['interior', 'ocean_view', 'balcony', 'suite'].index(ct.category) || 999 }
              cabin_types.each_with_index do |cabin_type, index|
            %>
              <% is_cabin_selected = params[:cabin_type_id].present? ? params[:cabin_type_id].to_i == cabin_type.id : (index == 0 && sailing_index == 0) %>
              <div class="flex-none w-32 cursor-pointer"
                   data-action="click->cruise-search#selectCabinType"
                   data-cabin-type-id="<%= cabin_type.id %>"
                   data-sailing-id="<%= sailing.id %>"
                   data-cruise-search-target="cabinCard">
                <div class="bg-white rounded-lg overflow-hidden border-2 hover:shadow-md transition <%= is_cabin_selected ? 'border-yellow-400' : 'border-gray-200' %>">
                  <!-- Cabin Image -->
                  <% if cabin_type.image_urls.present? && cabin_type.image_urls.first %>
                    <%= image_tag cabin_type.image_urls.first, alt: cabin_type.name, class: "w-full h-24 object-cover" %>
                  <% else %>
                    <div class="w-full h-24 bg-gray-100 flex items-center justify-center">
                      <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                      </svg>
                    </div>
                  <% end %>
                  
                  <!-- Cabin Info -->
                  <div class="p-3">
                    <div class="text-sm font-medium text-gray-900 mb-1"><%= cabin_type.name %></div>
                    <div class="text-xs text-gray-500 mb-2 line-clamp-2">
                      <%= cabin_type.feature_badges.take(2).join(' · ') %>
                    </div>
                    <% 
                      min_product = sailing.cruise_products.where(cabin_type: cabin_type, status: 'on_sale').order(:price_per_person).first
                    %>
                    <% if min_product %>
                      <div class="text-sm">
                        <span class="text-xs text-primary">¥</span>
                        <span class="font-bold text-primary"><%= min_product.price_per_person %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Room List Section -->
    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-4 py-4">
        <h3 class="text-base font-semibold text-gray-900 mb-4">选择房间</h3>
        
        <% @sailings.order(departure_date: :asc).each_with_index do |sailing, sailing_index| %>
          <% 
            cruise_ship = sailing.cruise_ship
            cabin_types = cruise_ship.cabin_types.sort_by { |ct| ['interior', 'ocean_view', 'balcony', 'suite'].index(ct.category) || 999 }
            cabin_types.each_with_index do |cabin_type, cabin_index|
          %>
            <div class="<%= sailing_index == 0 && cabin_index == 0 ? '' : 'hidden' %> space-y-3"
                 data-cruise-search-target="roomList"
                 data-sailing-id="<%= sailing.id %>"
                 data-cabin-type-id="<%= cabin_type.id %>">
              <% 
                products = sailing.cruise_products.where(cabin_type: cabin_type, status: 'on_sale').order(:price_per_person)
                if products.any?
                  products.each do |product|
              %>
                <div class="bg-white rounded-lg border border-gray-200 p-4 hover:shadow-sm transition">
                  <div class="flex items-start gap-4">
                    <!-- Room Image -->
                    <% if cabin_type.image_urls.present? && cabin_type.image_urls.first %>
                      <div class="flex-shrink-0 w-24 h-24 rounded-lg overflow-hidden">
                        <%= image_tag cabin_type.image_urls.first, alt: cabin_type.name, class: "w-full h-full object-cover" %>
                      </div>
                    <% end %>
                    
                    <!-- Room Info -->
                    <div class="flex-1 min-w-0">
                      <h4 class="font-medium text-gray-900 mb-1"><%= cabin_type.name %></h4>
                      <p class="text-sm text-gray-600 mb-2">
                        <%= cabin_type.floor_range %> · <%= cabin_type.area %>
                      </p>
                      
                      <!-- Features -->
                      <div class="flex flex-wrap gap-1.5 mb-2">
                        <% cabin_type.feature_badges.each do |badge| %>
                          <span class="inline-block px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded">
                            <%= badge %>
                          </span>
                        <% end %>
                      </div>
                      
                      <!-- Merchant & Badge -->
                      <div class="flex items-center gap-2 text-sm text-gray-500">
                        <span><%= product.merchant_name %></span>
                        <% if product.badge.present? %>
                          <span class="px-2 py-0.5 <%= product.badge_class %> text-xs rounded">
                            <%= product.badge %>
                          </span>
                        <% end %>
                      </div>
                    </div>
                    
                    <!-- Price & Action -->
                    <div class="flex-shrink-0 flex flex-col items-end justify-between">
                      <div class="text-right mb-3">
                        <div class="flex items-baseline gap-1">
                          <span class="text-xs text-gray-500">¥</span>
                          <span class="text-2xl font-bold text-primary"><%= product.price_per_person %></span>
                        </div>
                        <div class="text-xs text-gray-500">/人</div>
                      </div>
                      
                      <%= link_to "预订", cruise_sailing_path(sailing.id, cabin_type_id: cabin_type.id, route: params[:route], cruise_line_id: params[:cruise_line_id], city: params[:city], month: params[:month]), 
                                  class: "inline-block px-6 py-2 bg-yellow-400 text-gray-900 text-sm font-medium rounded-full hover:bg-yellow-500 transition" %>
                    </div>
                  </div>
                </div>
              <% 
                  end
                else
              %>
                <div class="text-center py-8 text-gray-500">
                  该舱房类型暂无房间
                </div>
              <% 
                end
              %>
            </div>
          <% 
            end
          %>
        <% end %>
      </div>
    </section>

    <!-- Itinerary Section -->
    <% @sailings.order(departure_date: :asc).each_with_index do |sailing, sailing_index| %>
      <% itinerary_data = sailing.itinerary_list %>
      <% if itinerary_data.any? %>
        <section class="bg-surface <%= sailing_index == 0 ? '' : 'hidden' %>"
                 data-cruise-search-target="itinerarySection"
                 data-sailing-id="<%= sailing.id %>">
          <div class="max-w-7xl mx-auto px-4 py-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-base font-semibold text-gray-900">行程安排</h3>
              <div class="text-sm text-gray-500">
                <%= sailing.cruise_ship.name %> · <%= sailing.departure_date.strftime('%Y年%m月%d日') %> 出发
              </div>
            </div>
            
            <div class="bg-white rounded-lg p-4">
              <div class="space-y-4">
                <% itinerary_data.each_with_index do |day_plan, index| %>
                  <div class="flex gap-4">
                    <!-- Day Number -->
                    <div class="flex-shrink-0 flex flex-col items-center">
                      <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center text-sm font-medium">
                        D<%= day_plan['day'] || day_plan[:day] %>
                      </div>
                      <% if index < itinerary_data.length - 1 %>
                        <div class="w-0.5 flex-1 bg-gray-200 mt-2"></div>
                      <% end %>
                    </div>
                    
                    <!-- Day Info -->
                    <div class="flex-1 <%= index < itinerary_data.length - 1 ? 'pb-4' : '' %>">
                      <h4 class="font-medium text-gray-900 mb-2">
                        <%= day_plan['port'] || day_plan[:port] %>
                      </h4>
                      <p class="text-sm text-gray-600 leading-relaxed">
                        <%= day_plan['description'] || day_plan[:description] %>
                      </p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </section>
      <% end %>
    <% end %>

  <% else %>
    <!-- Empty State -->
    <div class="max-w-7xl mx-auto px-4 py-20 text-center">
      <svg class="w-20 h-20 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
      </svg>
      <h3 class="text-lg font-medium text-gray-900 mb-2">暂无可预订的游轮</h3>
      <p class="text-gray-500 mb-4">该航线暂时没有在售班次</p>
      <%= link_to cruises_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        返回首页
      <% end %>
    </div>
  <% end %>

  <!-- Itinerary Modal -->
  <div class="hidden fixed inset-0 bg-black/50 z-50 flex items-end" data-cruise-search-target="itineraryModal">
    <div class="w-full" data-cruise-search-target="itineraryContent">
      <!-- Content will be dynamically loaded here -->
    </div>
  </div>
</div>
