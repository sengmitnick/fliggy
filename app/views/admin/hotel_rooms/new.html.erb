<% content_for :title, "New Hotel room" %>

<div class="container-md">
  <div class="flex items-center space-x-4">
    <%= link_to admin_hotel_rooms_path, class: "btn-ghost text-sm py-1 px-3" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Hotel rooms
    <% end %>
  </div>

  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-50 mt-4 mb-8">Create New Hotel room</h1>

  <!-- Form -->
  <div class="card bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
    <div class="card-body">
      <%= form_with model: [:admin, @hotel_room], local: true, class: "space-y-6" do |form| %>
        <%= render 'shared/form_error_message', model: @hotel_room %>

        <!-- Room type -->
        <div class="mb-4">
          <%= form.label :room_type, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Room type<% if field_required?(@hotel_room, :room_type) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.text_field :room_type, {
            placeholder: "Enter room type...",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50"
          }.merge(field_required?(@hotel_room, :room_type) ? { required: true } : {}) %>
          <% if @hotel_room.errors[:room_type].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:room_type].first %></p>
          <% end %>
        </div>

        <!-- Bed type -->
        <div class="mb-4">
          <%= form.label :bed_type, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Bed type<% if field_required?(@hotel_room, :bed_type) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.text_field :bed_type, {
            placeholder: "Enter bed type...",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50"
          }.merge(field_required?(@hotel_room, :bed_type) ? { required: true } : {}) %>
          <% if @hotel_room.errors[:bed_type].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:bed_type].first %></p>
          <% end %>
        </div>

        <!-- Price -->
        <div class="mb-4">
          <%= form.label :price, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Price<% if field_required?(@hotel_room, :price) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.number_field :price, {
            placeholder: "Enter price...",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50"
          }.merge(field_required?(@hotel_room, :price) ? { required: true } : {}) %>
          <% if @hotel_room.errors[:price].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:price].first %></p>
          <% end %>
        </div>

        <!-- Original price -->
        <div class="mb-4">
          <%= form.label :original_price, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Original price<% if field_required?(@hotel_room, :original_price) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.number_field :original_price, {
            placeholder: "Enter original price...",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50"
          }.merge(field_required?(@hotel_room, :original_price) ? { required: true } : {}) %>
          <% if @hotel_room.errors[:original_price].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:original_price].first %></p>
          <% end %>
        </div>

        <!-- Area -->
        <div class="mb-4">
          <%= form.label :area, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Area<% if field_required?(@hotel_room, :area) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.text_field :area, {
            placeholder: "Enter area...",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50"
          }.merge(field_required?(@hotel_room, :area) ? { required: true } : {}) %>
          <% if @hotel_room.errors[:area].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:area].first %></p>
          <% end %>
        </div>

        <!-- Max guests -->
        <div class="mb-4">
          <%= form.label :max_guests, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Max guests<% if field_required?(@hotel_room, :max_guests) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.number_field :max_guests, {
            placeholder: "Enter max guests...",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50"
          }.merge(field_required?(@hotel_room, :max_guests) ? { required: true } : {}) %>
          <% if @hotel_room.errors[:max_guests].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:max_guests].first %></p>
          <% end %>
        </div>

        <!-- Has window -->
        <div class="mb-4">
          <label class="flex items-center cursor-pointer">
            <%= form.check_box :has_window, 
                  class: "mr-3 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 dark:border-gray-600 rounded dark:bg-gray-700" %>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Has window</span>
          </label>
        </div>

        <!-- Available rooms -->
        <div class="mb-4">
          <%= form.label :available_rooms, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Available rooms<% if field_required?(@hotel_room, :available_rooms) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.number_field :available_rooms, {
            placeholder: "Enter available rooms...",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50"
          }.merge(field_required?(@hotel_room, :available_rooms) ? { required: true } : {}) %>
          <% if @hotel_room.errors[:available_rooms].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:available_rooms].first %></p>
          <% end %>
        </div>

        <!-- Room category -->
        <div class="mb-4">
          <%= form.label :room_category, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Room category<% if field_required?(@hotel_room, :room_category) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.select :room_category,
              options_for_select([['Overnight (默认)', 'overnight'], ['Hourly (钟点房)', 'hourly']], @hotel_room.room_category || 'overnight'),
              {},
              { class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50" } %>
          <p class="text-sm text-gray-500 mt-1">注意：此字段已移除业务逻辑限制，所有房间均可按任意天数灵活预订。默认为 'overnight'。</p>
          <% if @hotel_room.errors[:room_category].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:room_category].first %></p>
          <% end %>
        </div>

        <!-- Data version -->
        <div class="mb-4">
          <%= form.label :data_version, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Data version<% if field_required?(@hotel_room, :data_version) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.text_field :data_version, {
            placeholder: "Enter data version...",
            class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50"
          }.merge(field_required?(@hotel_room, :data_version) ? { required: true } : {}) %>
          <% if @hotel_room.errors[:data_version].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:data_version].first %></p>
          <% end %>
        </div>

        <!-- Hotel -->
        <div class="mb-4">
          <%= form.label :hotel_id, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" do %>
            Hotel<% if field_required?(@hotel_room, :hotel) %> <span class="text-red-500">*</span><% end %>
          <% end %>
          <%= form.select :hotel_id, 
              options_for_select([['Select Hotel', '']] + Hotel.all.map { |item| [item.name, item.id] }, @hotel_room.hotel_id),
              {},
              { class: "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:text-gray-50" } %>
          <% if @hotel_room.errors[:hotel_id].any? %>
            <p class="text-sm text-red-500 mt-1"><%= @hotel_room.errors[:hotel_id].first %></p>
          <% end %>
        </div>

        <!-- Form Actions -->
        <div class="flex justify-end space-x-3">
          <%= link_to admin_hotel_rooms_path, class: "btn-ghost" do %>
            Cancel
          <% end %>
          <%= form.submit "Create Hotel room", class: "btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>