<div class="min-h-screen bg-[#F9F9F9]" data-controller="location-selector city-selector"
     data-location-selector-api-endpoint-value="/transfers/locations"
     data-location-selector-location-type-value=""
     <% if @transfer_params && @transfer_params[:flight_id].present? %>
       <% flight = Flight.find_by(id: @transfer_params[:flight_id]) %>
       <% if flight %>
         data-location-selector-current-city-value="<%= @service_type == 'from_airport' ? flight.destination_city : flight.departure_city %>"
         data-location-selector-arrival-city-value="<%= @service_type == 'from_airport' ? flight.destination_city : flight.departure_city %>"
       <% end %>
     <% elsif @transfer_params && @transfer_params[:train_id].present? %>
       <% train = Train.find_by(id: @transfer_params[:train_id]) %>
       <% if train %>
         data-location-selector-current-city-value="<%= @service_type == 'from_station' ? train.arrival_city : train.departure_city %>"
         data-location-selector-arrival-city-value="<%= @service_type == 'from_station' ? train.arrival_city : train.departure_city %>"
       <% end %>
     <% end %>>
  <!-- Top background gradient -->
  <div class="absolute top-0 left-0 w-full h-48 bg-gradient-to-b from-[#FFF5E3] to-[#F9F9F9] z-0"></div>

  <!-- Top Navigation Bar -->
  <div class="relative z-10 px-4 py-3 flex items-center justify-between">
    <%= link_to profile_path, class: "text-text-secondary" do %>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    <% end %>
    
    <div class="text-center">
      <div class="flex items-center justify-center gap-1">
        <span class="text-lg font-bold text-[#8B5C35]">平台保障 服务升级</span>
      </div>
      <div class="text-[10px] text-[#8B5C35] opacity-80 mt-0.5">无车退赔 航变无忧 一价全包</div>
    </div>

    <div class="flex items-center gap-3">
      <!-- Shield icon -->
      <div class="w-7 h-7 bg-orange-100 rounded-full flex items-center justify-center border border-orange-200">
        <svg class="w-4 h-4 text-orange-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
      </div>
      <!-- Coupon icon -->
      <div class="relative">
        <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 4a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V4zm2 2v10h12V6H4z"/>
        </svg>
        <div class="absolute -top-1 -right-1 w-2 h-2 bg-red-600 rounded-full"></div>
      </div>
      <!-- Menu dots -->
      <svg class="w-6 h-6 text-text-secondary" fill="currentColor" viewBox="0 0 20 20">
        <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z"/>
      </svg>
    </div>
  </div>

  <!-- Service Type Tabs -->
  <div class="relative z-10 flex justify-between items-end px-6 mt-4 pb-2">
    <div class="text-text-muted text-sm pb-1 cursor-pointer" onclick="window.showToast('精彩即将上线，敬请期待')">
      顺风车
    </div>
    <%= link_to transfers_path, class: "flex flex-col items-center #{'text-text-primary font-bold text-lg' if @transfer_type.in?(%w[airport_pickup airport_dropoff])} #{'text-text-muted text-sm pb-1' unless @transfer_type.in?(%w[airport_pickup airport_dropoff])}" do %>
      <span>接送机</span>
      <% if @transfer_type.in?(%w[airport_pickup airport_dropoff]) %>
        <div class="w-6 h-1 bg-black rounded-full mt-1"></div>
      <% end %>
    <% end %>
    <%= link_to transfers_path(service: 'from_station'), class: "flex flex-col items-center #{'text-text-primary font-bold text-lg' if @transfer_type.in?(%w[train_pickup train_dropoff])} #{'text-text-muted text-sm pb-1' unless @transfer_type.in?(%w[train_pickup train_dropoff])}" do %>
      <span>接送火车</span>
      <% if @transfer_type.in?(%w[train_pickup train_dropoff]) %>
        <div class="w-6 h-1 bg-black rounded-full mt-1"></div>
      <% end %>
    <% end %>
    <div class="text-text-muted text-sm pb-1 cursor-pointer" onclick="window.showToast('精彩即将上线，敬请期待')">
      打车
    </div>
  </div>

  <!-- Service Direction Toggle (Pickup/Dropoff) -->
  <div class="relative z-10 px-4 mt-2">
    <div class="bg-gray-200/50 p-1 rounded-full flex">
      <% if @transfer_type.in?(%w[airport_pickup airport_dropoff]) %>
        <%= link_to transfers_path(type: @transfer_type, service: 'from_airport'), 
          class: "flex-1 py-2 rounded-full text-sm font-semibold text-center #{@service_type == 'from_airport' ? 'bg-[#FFD800] shadow-sm' : 'text-text-secondary font-medium'}" do %>
          到机场接我
        <% end %>
        <%= link_to transfers_path(type: @transfer_type, service: 'to_airport'),
          class: "flex-1 py-2 rounded-full text-sm font-semibold text-center #{@service_type == 'to_airport' ? 'bg-[#FFD800] shadow-sm' : 'text-text-secondary font-medium'}" do %>
          送我到机场
        <% end %>
      <% else %>
        <%= link_to transfers_path(type: @transfer_type, service: 'from_station'),
          class: "flex-1 py-2 rounded-full text-sm font-semibold text-center #{@service_type == 'from_station' ? 'bg-[#FFD800] shadow-sm' : 'text-text-secondary font-medium'}" do %>
          到车站接我
        <% end %>
        <%= link_to transfers_path(type: @transfer_type, service: 'to_station'),
          class: "flex-1 py-2 rounded-full text-sm font-semibold text-center #{@service_type == 'to_station' ? 'bg-[#FFD800] shadow-sm' : 'text-text-secondary font-medium'}" do %>
          送我到车站
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Main Input Card -->
  <div class="relative z-10 px-4 mt-4">
    <div class="bg-surface rounded-xl shadow-sm p-4">
      
      <% if @transfer_type.in?(%w[airport_pickup airport_dropoff]) %>
        <!-- Airport Section -->
        <div class="flex items-start mb-6">
          <div class="mt-1 mr-3">
            <svg class="w-5 h-5 text-black transform rotate-90" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
            </svg>
          </div>
          <div class="flex-1 border-b border-border pb-4">
            <div class="text-xs text-text-muted mb-1">
              <%= @service_type == 'from_airport' ? '降落机场' : '起飞机场' %>
            </div>
            <% if @service_type == 'from_airport' %>
              <%= link_to search_flights_transfers_path(transfer_type: @transfer_type, service_type: @service_type), class: "flex justify-between items-center" do %>
                <div class="flex-1">
                  <% if @transfer_params && @transfer_params[:flight_id].present? %>
                    <% flight = Flight.find_by(id: @transfer_params[:flight_id]) %>
                    <% if flight %>
                      <% # 根据service_type显示对应的机场：from_airport=降落机场, to_airport=起飞机场 %>
                      <% airport_name = @service_type == 'from_airport' ? flight.arrival_airport : flight.departure_airport %>
                      <% time_label = @service_type == 'from_airport' ? '到达后用车' : '出发前用车' %>
                      <% display_time = @service_type == 'from_airport' ? flight.arrival_time : flight.departure_time %>
                      <h2 class="text-xl font-bold text-text-primary" data-location-from="<%= airport_name %>"><%= airport_name %></h2>
                      <div class="text-xs text-text-secondary mt-1">
                        <%= flight.flight_number %> 预计当地<%= display_time&.strftime('%m月%d日') %><%= %w[周日 周一 周二 周三 周四 周五 周六][display_time&.wday] %> <%= display_time&.strftime('%H:%M') %><%= time_label %>
                      </div>
                    <% else %>
                      <h2 class="text-lg font-bold text-text-muted">请选择机场</h2>
                    <% end %>
                  <% else %>
                    <h2 class="text-lg font-bold text-text-muted">请选择机场</h2>
                  <% end %>
                </div>
                <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
            <% else %>
              <button
                type="button"
                data-action="click->location-selector#openModal"
                data-location-type="airport"
                class="flex justify-between items-center w-full">
                <div class="flex-1">
                  <% if @transfer_params && @transfer_params[:location_to].present? %>
                    <h2 class="text-xl font-bold text-text-primary" data-location-to="<%= @transfer_params[:location_to] %>" data-location-selector-target="airportDisplay"><%= @transfer_params[:location_to] %></h2>
                  <% else %>
                    <h2 class="text-lg font-bold text-text-muted" data-location-selector-target="airportDisplay">请选择机场</h2>
                  <% end %>
                </div>
                <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
              <%= hidden_field_tag :location_to, @transfer_params&.dig(:location_to), id: 'transfer-airport-destination', data: { 'location-selector-target': 'airportInput' } %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="flex items-start mb-6">
          <div class="mt-1 mr-3">
            <svg class="w-5 h-5 text-gray-800" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="flex-1 border-b border-border pb-4">
            <div class="text-xs text-text-muted mb-1">
              <%= @service_type == 'from_station' ? '到达火车站' : '出发火车站' %>
            </div>
            <% if @service_type == 'from_station' %>
              <%= link_to search_trains_transfers_path(transfer_type: @transfer_type, service_type: @service_type), class: "flex justify-between items-center" do %>
                <div class="flex-1">
                  <% if @transfer_params && @transfer_params[:train_id].present? %>
                    <% train = Train.find_by(id: @transfer_params[:train_id]) %>
                    <% if train %>
                      <% # 根据service_type显示对应的车站：from_station=到达车站, to_station=出发车站 %>
                      <% station_name = @service_type == 'from_station' ? train.arrival_station : train.departure_station %>
                      <% time_label = @service_type == 'from_station' ? '到达后用车' : '出发前用车' %>
                      <% display_time = @service_type == 'from_station' ? train.arrival_time : train.departure_time %>
                      <h2 class="text-xl font-bold text-text-primary" data-location-from="<%= station_name %>"><%= station_name %></h2>
                      <div class="text-xs text-text-secondary mt-1">
                        <%= train.train_number %> 预计当地<%= display_time&.strftime('%m月%d日') %><%= %w[周日 周一 周二 周三 周四 周五 周六][display_time&.wday] %> <%= display_time&.strftime('%H:%M') %><%= time_label %>
                      </div>
                    <% else %>
                      <h2 class="text-lg font-bold text-text-muted">请选择火车站</h2>
                    <% end %>
                  <% else %>
                    <h2 class="text-lg font-bold text-text-muted">请选择火车站</h2>
                  <% end %>
                </div>
                <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
            <% else %>
              <button
                type="button"
                data-action="click->location-selector#openModal"
                data-location-type="station"
                class="flex justify-between items-center w-full">
                <div class="flex-1">
                  <% if @transfer_params && @transfer_params[:location_to].present? %>
                    <h2 class="text-xl font-bold text-text-primary" data-location-to="<%= @transfer_params[:location_to] %>" data-location-selector-target="stationDisplay"><%= @transfer_params[:location_to] %></h2>
                  <% else %>
                    <h2 class="text-lg font-bold text-text-muted" data-location-selector-target="stationDisplay">请选择火车站</h2>
                  <% end %>
                </div>
                <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
              <%= hidden_field_tag :location_to, @transfer_params&.dig(:location_to), id: 'transfer-station-destination', data: { 'location-selector-target': 'stationInput' } %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Dropoff/Pickup Location -->
      <div class="flex items-start">
        <div class="mt-1 mr-3">
          <svg class="w-5 h-5 text-gray-800" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="flex-1">
          <div class="text-xs text-text-muted mb-1">
            <%= @service_type.in?(%w[from_airport from_station]) ? '下车点' : '上车点' %>
          </div>
          <button
            type="button"
            data-action="click->location-selector#openModal"
            data-location-type="pickup"
            class="flex justify-between items-center w-full">
            <div class="flex-1">
              <% # For to_airport/to_station: pickup point is location_from; for from_airport/from_station: dropoff point is location_to %>
              <% location_value = @service_type.in?(%w[to_airport to_station]) ? @transfer_params&.dig(:location_from) : @transfer_params&.dig(:location_to) %>
              <% if location_value.present? %>
                <h2 class="text-lg font-bold text-text-primary leading-tight pr-2" data-location-selector-target="locationDisplay"><%= location_value %></h2>
                <div class="mt-2 inline-block bg-[#FFFBE0] text-[#8B5C35] text-[10px] px-2 py-1 rounded">
                  <%= location_value %>
                </div>
              <% else %>
                <h2 class="text-lg font-bold text-text-muted" data-location-selector-target="locationDisplay">请选择地点</h2>
              <% end %>
            </div>
            <svg class="w-4 h-4 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
          <% if @service_type.in?(%w[to_airport to_station]) %>
            <%= hidden_field_tag :location_from, @transfer_params&.dig(:location_from), id: 'transfer-location-from', data: { 'location-selector-target': 'locationInput' } %>
          <% else %>
            <%= hidden_field_tag :location_to, @transfer_params&.dig(:location_to), id: 'transfer-location-to', data: { 'location-selector-target': 'locationInput' } %>
          <% end %>
        </div>
      </div>

      <!-- 预计距离（如果两个地点都已选择） -->
      <% if @transfer_params && @transfer_params[:location_from].present? && @transfer_params[:location_to].present? %>
        <div class="mt-4 text-xs text-text-muted pl-8">
          预计行驶: 48公里/51分钟
        </div>
      <% end %>

      <!-- 
        用车时间选择器
        
        显示条件：仅在"送我到机场/车站"模式下显示
        - to_airport: 送我到机场
        - to_station: 送我到车站
        
        为什么只在这两种模式下显示？
        - from_airport/from_station：航班/火车已有到达时间，不需要用户再选择
        - to_airport/to_station：用户需要指定什么时间来接，必须手动选择
        
        交互设计：
        - 点击按钮打开 iOS 风格的滚动时间选择器
        - 选择完成后，时间显示在按钮上（例如："今天 01/15 14:30"）
        - transfer_search_controller.ts 会验证该字段是否已选择
      -->
      <% if @service_type.in?(%w[to_airport to_station]) %>
        <div class="flex items-start mt-6" data-controller="transfer-time-picker">
          <!-- 时钟图标 -->
          <div class="mt-1 mr-3">
            <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="flex-1">
            <div class="text-xs text-text-muted mb-1">
              请选择用车时间
            </div>
            <!-- 
              触发按钮：点击后打开时间选择器弹窗
              data-action: 绑定到 transfer-time-picker#openModal 方法
            -->
            <button
              type="button"
              data-action="click->transfer-time-picker#openModal"
              class="flex justify-between items-center w-full">
              <div class="flex-1">
                <!-- 
                  显示文本：
                  - 初始值："请选择时间"（灰色）
                  - 选择后："今天 01/15 14:30"（黑色）
                  transfer_time_picker_controller.ts 会更新这个 <h2> 元素的内容
                -->
                <h2 class="text-lg font-bold text-text-muted">请选择时间</h2>
              </div>
              <!-- 右箭头图标 -->
              <svg class="w-4 h-4 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>

          <!-- 引入时间选择器弹窗模板（定义在 app/views/shared/_transfer_time_picker_modal.html.erb） -->
          <%= render 'shared/transfer_time_picker_modal' %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Coupon Notice & Search Button -->
  <div class="px-4 mt-4">
    

    <div class="relative">
      <!-- Floating badge -->
      <div class="absolute -top-3 right-0 bg-[#FF4D4F] text-white text-[10px] px-2 py-1 rounded-tl-lg rounded-tr-lg rounded-br-lg z-20 shadow-sm border border-white">
        新客专享 至高减¥80
      </div>
      
      <button
        type="button"
        id="search-transfer-btn"
        data-controller="transfer-search"
        data-transfer-search-transfer-type-value="<%= @transfer_type %>"
        data-transfer-search-service-type-value="<%= @service_type %>"
        data-transfer-search-flight-id-value="<%= @transfer_params&.dig(:flight_id) %>"
        data-transfer-search-train-id-value="<%= @transfer_params&.dig(:train_id) %>"
        data-action="click->transfer-search#handleSearch"
        class="w-full block text-center bg-[#FFD800] text-black font-bold text-lg py-3 rounded-full shadow-md active:scale-95 transition-transform">
        搜索<%= @transfer_type.in?(%w[airport_pickup airport_dropoff]) ? '接送机' : '接送站' %>
      </button>
    </div>
    
    <div class="text-center mt-3 flex items-center justify-center gap-2 text-[10px] text-text-muted">
      <span class="font-bold text-text-primary">平台保障</span> 无车退赔 · 一价全包 · 航变无忧
      <svg class="w-3 h-3 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </div>
  </div>

  <!-- Super Value Deals Card -->
  <div class="px-4 mt-5">
    
  </div>

  <!-- Include Location Selector Modal -->
  <%= render 'shared/location_selector_modal' %>

  <!-- Include City Selector Modal -->
  <%= render 'shared/city_selector_modal' %>
</div>
