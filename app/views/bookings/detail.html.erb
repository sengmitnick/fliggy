<div class="min-h-screen bg-gray-100">
  <!-- Header -->
  <div class="bg-white border-b">
    <div class="container mx-auto px-4 py-4 flex items-center justify-between">
      <%= link_to bookings_path, class: "text-2xl" do %>
        ←
      <% end %>
      <h1 class="text-lg font-bold">订单详情</h1>
      <button type="button" class="text-2xl">
        ⋮
      </button>
    </div>
  </div>

  <!-- Status Badge -->
  <div class="container mx-auto px-4 py-3">
    <div class="bg-white rounded-lg shadow p-4 text-center">
      <% if @booking.status == 'paid' || @booking.status == 'completed' %>
        <div class="text-green-500 text-5xl mb-2">✓</div>
        <h2 class="text-xl font-bold mb-1">出票成功</h2>
        <p class="text-sm text-gray-500">请按时登机</p>
      <% elsif @booking.status == 'pending' %>
        <div class="text-yellow-500 text-5xl mb-2">⏳</div>
        <h2 class="text-xl font-bold mb-1">待支付</h2>
        <p class="text-sm text-gray-500">请尽快完成支付</p>
      <% elsif @booking.status == 'cancelled' %>
        <div class="text-gray-500 text-5xl mb-2">✕</div>
        <h2 class="text-xl font-bold mb-1">已取消</h2>
        <p class="text-sm text-gray-500">订单已关闭</p>
      <% end %>
    </div>
  </div>

  <!-- Flight Info Card -->
  <div class="container mx-auto px-4 mb-4">
    <% if @booking.trip_type == 'multi_city' && @booking.multi_city_flights.present? %>
      <!-- Multi-city Flights -->
      <% @booking.multi_city_flight_objects.each_with_index do |flight, index| %>
        <% next unless flight %>
        <div class="bg-white rounded-lg shadow p-4 <%= 'mb-4' unless index == @booking.multi_city_flight_objects.length - 1 %>">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center space-x-2">
              <span class="bg-purple-500 text-white px-2 py-1 rounded text-xs font-bold">第<%= index + 1 %>程</span>
              <span class="text-lg font-bold"><%= flight.departure_time.strftime('%-m月%-d日') %> 周<%= flight.departure_time.strftime('%u') %> <%= flight.departure_time.strftime('%H:%M') %></span>
            </div>
          </div>

          <div class="flex items-center justify-between mb-4">
            <div>
              <div class="text-2xl font-bold"><%= flight.departure_time.strftime('%H:%M') %></div>
              <div class="text-sm text-gray-600"><%= flight.departure_city %></div>
              <div class="text-xs text-gray-500"><%= flight.departure_airport %></div>
            </div>
            <div class="flex-1 text-center px-4">
              <div class="text-xs text-gray-500"><%= flight.duration_formatted %></div>
              <div class="border-t border-gray-300 my-1"></div>
              <div class="text-xs text-green-600">直飞</div>
            </div>
            <div class="text-right">
              <div class="text-2xl font-bold"><%= flight.arrival_time.strftime('%H:%M') %></div>
              <div class="text-sm text-gray-600"><%= flight.destination_city %></div>
              <div class="text-xs text-gray-500"><%= flight.arrival_airport %></div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
    <!-- Outbound Flight -->
    <div class="bg-white rounded-lg shadow p-4 <%= 'mb-4' if @booking.trip_type == 'round_trip' && @booking.return_flight %>">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2">
          <% if @booking.trip_type == 'round_trip' %>
            <span class="bg-yellow-400 text-gray-900 px-2 py-1 rounded text-xs font-bold">去程</span>
          <% end %>
          <span class="text-lg font-bold"><%= @flight.departure_time.strftime('%-m月%-d日') %> 周<%= @flight.departure_time.strftime('%u') %> <%= @flight.departure_time.strftime('%H:%M') %></span>
        </div>
      </div>

      <div class="flex items-center justify-between mb-4">
        <div>
          <div class="text-2xl font-bold"><%= @flight.departure_time.strftime('%H:%M') %></div>
          <div class="text-sm text-gray-600"><%= @flight.departure_city %></div>
          <div class="text-xs text-gray-500"><%= @flight.departure_airport %></div>
        </div>
        <div class="flex-1 text-center px-4">
          <div class="text-xs text-gray-500"><%= @flight.duration_formatted %></div>
          <div class="border-t border-gray-300 my-1"></div>
          <div class="text-xs text-green-600">直飞</div>
        </div>
        <div class="text-right">
          <div class="text-2xl font-bold"><%= @flight.arrival_time.strftime('%H:%M') %></div>
          <div class="text-sm text-gray-600"><%= @flight.destination_city %></div>
          <div class="text-xs text-gray-500"><%= @flight.arrival_airport %></div>
        </div>
      </div>

      <div class="bg-gray-50 rounded p-3">
        <div class="text-xs text-gray-600">
          <span><%= @flight.airline %> <%= @flight.flight_number %></span>
          <span class="mx-2">|</span>
          <span><%= @flight.aircraft_type || '波音737' %></span>
        </div>
      </div>
    </div>

    <!-- Return Flight -->
    <% if @booking.trip_type == 'round_trip' && @booking.return_flight %>
      <div class="bg-white rounded-lg shadow p-4">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center space-x-2">
            <span class="bg-blue-400 text-white px-2 py-1 rounded text-xs font-bold">返程</span>
            <span class="text-lg font-bold"><%= @booking.return_flight.departure_time.strftime('%-m月%-d日') %> 周<%= @booking.return_flight.departure_time.strftime('%u') %> <%= @booking.return_flight.departure_time.strftime('%H:%M') %></span>
          </div>
        </div>

        <div class="flex items-center justify-between mb-4">
          <div>
            <div class="text-2xl font-bold"><%= @booking.return_flight.departure_time.strftime('%H:%M') %></div>
            <div class="text-sm text-gray-600"><%= @booking.return_flight.departure_city %></div>
            <div class="text-xs text-gray-500"><%= @booking.return_flight.departure_airport %></div>
          </div>
          <div class="flex-1 text-center px-4">
            <div class="text-xs text-gray-500"><%= @booking.return_flight.duration_formatted %></div>
            <div class="border-t border-gray-300 my-1"></div>
            <div class="text-xs text-green-600">直飞</div>
          </div>
          <div class="text-right">
            <div class="text-2xl font-bold"><%= @booking.return_flight.arrival_time.strftime('%H:%M') %></div>
            <div class="text-sm text-gray-600"><%= @booking.return_flight.destination_city %></div>
            <div class="text-xs text-gray-500"><%= @booking.return_flight.arrival_airport %></div>
          </div>
        </div>

        <div class="bg-gray-50 rounded p-3">
          <div class="text-xs text-gray-600">
            <span><%= @booking.return_flight.airline %> <%= @booking.return_flight.flight_number %></span>
            <span class="mx-2">|</span>
            <span><%= @booking.return_flight.aircraft_type || '波音737' %></span>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
  </div>

  <!-- Order Details Section -->
  <% group_bookings = @booking.group_bookings %>
  <div class="container mx-auto px-4 mb-4">
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-base font-bold text-gray-900 mb-4">订单信息</h3>
      
      <div class="space-y-3">
        <div class="flex justify-between text-sm">
          <span class="text-gray-600">订单编号</span>
          <span class="font-medium">#<%= @booking.id %></span>
        </div>

        <div class="flex justify-between text-sm">
          <span class="text-gray-600">订单状态</span>
          <% if @booking.status == 'paid' || @booking.status == 'completed' %>
            <span class="font-medium text-green-600">已支付</span>
          <% elsif @booking.status == 'pending' %>
            <span class="font-medium text-yellow-600">待支付</span>
          <% elsif @booking.status == 'cancelled' %>
            <span class="font-medium text-gray-500">已取消</span>
          <% end %>
        </div>

        <div class="flex justify-between text-sm">
          <span class="text-gray-600">订单金额</span>
          <span class="font-bold text-red-500 text-lg">¥<%= @booking.group_total_price.to_i %></span>
        </div>

        <div class="flex justify-between text-sm">
          <span class="text-gray-600">乘机人数</span>
          <span class="font-medium"><%= group_bookings.size %>人</span>
        </div>

        <% if @booking.contact_phone.present? %>
        <div class="flex justify-between text-sm">
          <span class="text-gray-600">联系电话</span>
          <span class="font-medium"><%= @booking.contact_phone %></span>
        </div>
        <% end %>

        <div class="flex justify-between text-sm">
          <span class="text-gray-600">创建时间</span>
          <span class="font-medium"><%= @booking.created_at.strftime('%Y-%m-%d %H:%M') %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Passenger Details Section -->
  <div class="container mx-auto px-4 mb-4">
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-base font-bold text-gray-900 mb-4">乘机人信息</h3>
      
      <div class="space-y-4">
        <% group_bookings.each_with_index do |booking, index| %>
          <div class="<%= 'border-t pt-4' if index > 0 %>">
            <div class="flex items-center justify-between mb-2">
              <div class="text-sm font-medium text-gray-900">乘机人<%= index + 1 %></div>
              <% passenger = Passenger.find_by(name: booking.passenger_name, id_number: booking.passenger_id_number) %>
              <% if passenger&.child_ticket? %>
                <span class="text-xs bg-blue-100 text-blue-600 px-2 py-1 rounded">儿童票</span>
              <% end %>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <div class="text-xs text-gray-500 mb-1">姓名</div>
                <div class="text-sm text-gray-900"><%= booking.passenger_name %></div>
              </div>
              <div>
                <div class="text-xs text-gray-500 mb-1">身份证号</div>
                <div class="text-sm text-gray-900 font-mono">
                  <%= booking.passenger_id_number[0..5] %>********<%= booking.passenger_id_number[-4..-1] %>
                </div>
              </div>
              <div>
                <div class="text-xs text-gray-500 mb-1">票价</div>
                <div class="text-sm text-gray-900 font-medium">¥<%= booking.total_price.to_i %></div>
              </div>
              <% if booking.insurance_price.present? && booking.insurance_price > 0 %>
              <div>
                <div class="text-xs text-gray-500 mb-1">保险</div>
                <div class="text-sm text-gray-900">¥<%= booking.insurance_price.to_i %></div>
              </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="container mx-auto px-4 pb-6">
    <% if @booking.status == 'pending' %>
      <div class="flex space-x-3">
        <%= button_to '取消订单', cancel_booking_path(@booking), method: :patch, class: 'flex-1 bg-white border-2 border-gray-300 text-gray-700 py-3 rounded-full text-center font-bold', data: { confirm: '确定要取消这个订单吗？' } %>
        <%= link_to '立即支付', booking_path(@booking), class: 'flex-1 bg-blue-500 text-white py-3 rounded-full text-center font-bold' %>
      </div>
    <% else %>
      <%= link_to '返回订单列表', bookings_path, class: 'block w-full bg-blue-500 text-white py-3 rounded-full text-center font-bold' %>
    <% end %>
  </div>
</div>
