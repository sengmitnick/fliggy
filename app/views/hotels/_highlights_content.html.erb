<!-- 酒店亮点 -->
<div class="bg-white p-4">
  <h2 class="text-lg font-bold mb-4">酒店亮点</h2>
  
  <% if @hotel.hotel_highlights.any? %>
    <div class="space-y-4">
      <% @hotel.hotel_highlights.each do |highlight| %>
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 <%= highlight_icon_bg_color(highlight.icon) %> rounded-lg flex items-center justify-center">
            <%= highlight_icon_svg(highlight.icon) %>
          </div>
          <div>
            <div class="font-medium"><%= highlight.title %></div>
            <% if highlight.description.present? %>
              <div class="text-sm text-gray-600"><%= highlight.description %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-sm text-gray-500">暂无亮点信息</div>
  <% end %>
</div>

<!-- 酒店视频 -->
<div class="bg-white p-4 border-t border-gray-100">
  <div class="relative rounded-lg overflow-hidden">
    <%= safe_image_tag(@hotel.image_url, alt: @hotel.name, class: "w-full h-48 object-cover") %>
    <div class="absolute inset-0 bg-black bg-opacity-30 flex items-center justify-center">
      <button type="button" class="w-16 h-16 bg-white bg-opacity-80 rounded-full flex items-center justify-center" aria-label="播放视频">
        <svg class="w-8 h-8 text-gray-700 ml-1" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- 酒店设施 -->
<div class="bg-white p-4 border-t border-gray-100">
  <h2 class="text-lg font-bold mb-4">酒店设施</h2>
  
  <% if @hotel.facilities.present? %>
    <% facilities_array = @hotel.facilities.split(',').map(&:strip) %>
    <% facilities_with_images = facilities_array.select { |f| ['健身房', '游泳池', '洗衣房', '公共洗衣房'].include?(f) }.take(2) %>
    
    <% if facilities_with_images.any? %>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <% facilities_with_images.each do |facility| %>
          <div class="relative">
            <%= safe_image_tag(facility_image_url(facility), alt: facility, class: "w-full h-24 object-cover rounded-lg") %>
            <div class="absolute bottom-2 left-2 text-white text-sm font-medium"><%= facility %>(1)</div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4 text-sm">
      <% facilities_array.each do |facility| %>
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 <%= facility_color_class(facility) %> rounded-full"></span>
          <span class="flex items-center">
            <%= facility %>
            <% if free_facility?(facility) %>
              <span class="ml-1 px-1 text-xs bg-green-100 text-green-600 rounded">免费</span>
            <% end %>
          </span>
        </div>
      <% end %>
    </div>

    <button type="button" class="w-full mt-4 py-2 text-center text-gray-600 text-sm" aria-label="展开更多设施">展开 ∨</button>
  <% else %>
    <div class="text-sm text-gray-500">暂无设施信息</div>
  <% end %>
</div>

<!-- 酒店周边 -->
<div class="bg-white p-4 border-t border-gray-100">
  <h2 class="text-lg font-bold mb-4">酒店周边</h2>
  
  <!-- 地图区域 -->
  <div class="relative h-40 bg-gray-100 rounded-lg mb-4">
    <div class="absolute inset-0 bg-gradient-to-br from-green-100 to-blue-100 rounded-lg">
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2">
        <div class="w-8 h-8 bg-red-500 rounded-full flex items-center justify-center">
          <div class="w-2 h-2 bg-white rounded-full"></div>
        </div>
        <div class="mt-1 text-xs text-center font-medium"><%= @hotel.name %></div>
      </div>
    </div>
  </div>

  <% if @hotel.hotel_nearby_places.any? %>
    <% nearby_by_type = @hotel.hotel_nearby_places.group_by(&:place_type) %>
    
    <!-- 交通信息 -->
    <% if nearby_by_type['地铁站'].present? || nearby_by_type['火车站'].present? || nearby_by_type['机场'].present? %>
      <div class="mb-4">
        <h3 class="font-medium mb-3">交通</h3>
        <div class="space-y-3">
          <% (nearby_by_type['地铁站'] || []).each do |place| %>
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                <span class="text-blue-600 text-xs">🚇</span>
              </div>
              <div class="flex-1">
                <div class="font-medium"><%= place.name %></div>
                <div class="text-sm text-gray-600"><%= place.distance %></div>
              </div>
            </div>
          <% end %>
          
          <% (nearby_by_type['火车站'] || []).each do |place| %>
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                <span class="text-blue-600 text-xs">🚌</span>
              </div>
              <div class="flex-1">
                <div class="font-medium"><%= place.name %></div>
                <div class="text-sm text-gray-600"><%= place.distance %></div>
              </div>
            </div>
          <% end %>
          
          <% (nearby_by_type['机场'] || []).first(1).each do |place| %>
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                <span class="text-blue-600 text-xs">✈️</span>
              </div>
              <div class="flex-1">
                <div class="font-medium"><%= place.name %></div>
                <div class="text-sm text-gray-600"><%= place.distance %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- 景点信息 -->
    <% if nearby_by_type['景点'].present? %>
      <div class="mb-4">
        <h3 class="font-medium mb-3">景点</h3>
        <div class="space-y-3">
          <% nearby_by_type['景点'].each do |place| %>
            <div class="flex items-center space-x-3">
              <div class="flex-1">
                <div class="flex items-center space-x-2">
                  <span class="font-medium"><%= place.name %></span>
                  <% if place.description.present? %>
                    <span class="px-2 py-1 text-xs bg-orange-100 text-orange-600 rounded"><%= place.description %></span>
                  <% end %>
                </div>
                <div class="text-sm text-gray-600"><%= place.distance %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- 购物信息 -->
    <% if nearby_by_type['购物'].present? %>
      <div class="mb-4">
        <h3 class="font-medium mb-3">购物</h3>
        <div class="space-y-3">
          <% nearby_by_type['购物'].each do |place| %>
            <div class="flex items-center space-x-3">
              <div class="flex-1">
                <div class="font-medium"><%= place.name %></div>
                <div class="text-sm text-gray-600"><%= place.distance %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <button type="button" class="w-full py-2 text-center text-blue-600 text-sm font-medium" aria-label="查看周边地图">查看周边地图</button>
  <% else %>
    <div class="text-sm text-gray-500 text-center py-4">暂无周边信息</div>
  <% end %>
</div>
