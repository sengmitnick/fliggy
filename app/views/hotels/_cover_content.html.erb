<!-- 酒店基本信息 -->
<div class="bg-white p-4">
  <div class="flex items-start justify-between">
    <div class="flex-1">
      <h1 class="text-xl font-bold text-gray-900"><%= @hotel.name %></h1>
      <% tags = hotel_tags(@hotel) %>
      <% if tags.any? %>
        <div class="flex items-center mt-1 space-x-2">
          <% tags.each do |tag| %>
            <span class="px-2 py-1 text-xs bg-<%= tag[:color] %>-100 text-<%= tag[:color] %>-800 rounded"><%= tag[:text] %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    <button type="button" class="p-2 text-gray-400" aria-label="查看详情" onclick="window.showToast('精彩即将上线，敬请期待')">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
  </div>

  <% ranking = hotel_ranking_text(@hotel) %>
  <% if ranking.present? %>
    <div class="text-sm text-gray-600 mt-1"><%= ranking %></div>
  <% end %>
</div>

<!-- 酒店特色和评分 -->
<div class="bg-white p-4 border-t border-gray-100">
  <% if @hotel.facilities.present? %>
    <% facilities_array = @hotel.facilities.split(',').map(&:strip) %>
    <div class="grid gap-4" style="grid-template-columns: repeat(<%= [facilities_array.size, 5].min %>, minmax(0, 1fr));">
      <% facilities_array.take(5).each do |facility| %>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto bg-blue-50 rounded-lg flex items-center justify-center">
            <% case facility %>
            <% when /WiFi|网络/i %>
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M1 9l2 2c4.97-4.97 13.03-4.97 18 0l2-2C16.93 2.93 7.08 2.93 1 9zm8 8l3 3 3-3c-1.65-1.66-4.34-1.66-6 0zm-4-4l2 2c2.76-2.76 7.24-2.76 10 0l2-2C15.14 9.14 8.87 9.14 5 13z"/>
              </svg>
            <% when /停车/i %>
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M13 3H6v18h4v-6h3c3.31 0 6-2.69 6-6s-2.69-6-6-6zm.2 8H10V7h3.2c1.1 0 2 .9 2 2s-.9 2-2 2z"/>
              </svg>
            <% when /早餐|餐饮/i %>
              <svg class="w-6 h-6 text-orange-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/>
              </svg>
            <% when /健身/i %>
              <svg class="w-6 h-6 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 5.57 4.14 4.14 2.71 2.71 4.14l1.43 1.43L2 7.71l1.43 1.43L2 10.57 3.43 12 7 8.43 15.57 17 12 20.57 13.43 22l1.43-1.43L16.29 22l2.14-2.14 1.43 1.43 1.43-1.43-1.43-1.43L22 16.29l-1.43-1.43z"/>
              </svg>
            <% when /会议/i %>
              <svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
              </svg>
            <% when /游泳|泳池/i %>
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M22 21c-1.11 0-1.73-.37-2.18-.64-.37-.22-.6-.36-1.15-.36-.56 0-.78.13-1.15.36-.46.27-1.07.64-2.18.64s-1.73-.37-2.18-.64c-.37-.22-.6-.36-1.15-.36-.56 0-.78.13-1.15.36-.46.27-1.08.64-2.19.64-1.11 0-1.73-.37-2.18-.64-.37-.23-.6-.36-1.15-.36s-.78.13-1.15.36c-.46.27-1.08.64-2.19.64v-2c.56 0 .78-.13 1.15-.36.46-.27 1.08-.64 2.19-.64s1.73.37 2.18.64c.37.23.59.36 1.15.36.56 0 .78-.13 1.15-.36.46-.27 1.08-.64 2.19-.64 1.11 0 1.73.37 2.18.64.37.22.6.36 1.15.36s.78-.13 1.15-.36c.45-.27 1.07-.64 2.18-.64s1.73.37 2.18.64c.37.23.59.36 1.15.36v2zm0-4.5c-1.11 0-1.73-.37-2.18-.64-.37-.22-.6-.36-1.15-.36-.56 0-.78.13-1.15.36-.45.27-1.07.64-2.18.64s-1.73-.37-2.18-.64c-.37-.22-.6-.36-1.15-.36-.56 0-.78.13-1.15.36-.45.27-1.07.64-2.18.64s-1.73-.37-2.18-.64c-.37-.22-.6-.36-1.15-.36s-.78.13-1.15.36c-.47.27-1.09.64-2.2.64v-2c.56 0 .78-.13 1.15-.36.45-.27 1.07-.64 2.18-.64s1.73.37 2.18.64c.37.22.6.36 1.15.36.56 0 .78-.13 1.15-.36.45-.27 1.07-.64 2.18-.64s1.73.37 2.18.64c.37.22.6.36 1.15.36s.78-.13 1.15-.36c.45-.27 1.07-.64 2.18-.64s1.73.37 2.18.64c.37.22.6.36 1.15.36v2zM8.67 12c.56 0 .78-.13 1.15-.36.46-.27 1.08-.64 2.19-.64 1.11 0 1.73.37 2.18.64.37.22.6.36 1.15.36s.78-.13 1.15-.36c.12-.07.26-.15.41-.23L10.48 5C8.93 3.45 7.5 2.99 5 3v2.5c1.82-.01 2.89.39 4 1.5l1 1-3.25 3.25c.31.12.56.27.77.39.37.23.59.36 1.15.36z"/>
              </svg>
            <% else %>
              <svg class="w-6 h-6 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            <% end %>
          </div>
          <div class="text-xs text-gray-600 mt-1"><%= facility %></div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mt-4 p-3 bg-gray-50 rounded-lg">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="flex items-center space-x-1">
          <span class="text-2xl font-bold text-blue-600"><%= @hotel.average_rating.round(1) %></span>
          <span class="text-sm text-gray-600"><%= rating_text(@hotel.average_rating) %></span>
          <% if @hotel.reviews_count > 0 %>
            <span class="text-sm text-blue-600"><%= @hotel.reviews_count %>条 &gt;</span>
          <% else %>
            <span class="text-sm text-gray-500">暂无评价</span>
          <% end %>
        </div>
      </div>
      <div class="text-right">
        <div class="text-sm font-medium"><%= @hotel.distance_info %></div>
        <div class="text-xs text-gray-600"><%= @hotel.address %></div>
      </div>
      <button type="button" class="p-2 bg-gray-200 rounded-lg" aria-label="显示地图位置" onclick="window.showToast('精彩即将上线，敬请期待')">
        <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- 酒店服务特色 -->
<% if @hotel.features.present? && @hotel.features.is_a?(Array) && @hotel.features.any? %>
<div class="bg-white p-4 border-t border-gray-100">
  <h3 class="text-base font-bold text-gray-900 mb-3">酒店服务特色</h3>
  <div class="grid grid-cols-4 gap-3">
    <% @hotel.features.take(8).each do |feature| %>
      <div class="text-center">
        <div class="w-12 h-12 mx-auto bg-gradient-to-br <%= feature_gradient_class(feature) %> rounded-lg flex items-center justify-center mb-1">
          <%= feature_icon_svg(feature).html_safe %>
        </div>
        <div class="text-xs text-gray-700"><%= feature %></div>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<!-- F2直通希尔顿银会员 -->
<div class="bg-gradient-to-r from-amber-50 to-orange-50 p-4 border-t border-gray-100">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="text-lg font-bold text-amber-800">F2直通希尔顿银会员</div>
    </div>
    <button type="button" class="bg-amber-600 text-white px-4 py-2 rounded-full text-sm font-medium" onclick="window.showToast('精彩即将上线，敬请期待')">免费开通 享会员权益 &gt;</button>
  </div>

  <div class="grid grid-cols-4 gap-4 mt-3">
    <div class="text-center">
      <div class="text-sm font-medium text-amber-800">🎁 1.2倍</div>
      <div class="text-xs text-gray-600">奖励积分</div>
    </div>
    <div class="text-center">
      <div class="text-sm font-medium text-amber-800">🔓 开卡享</div>
      <div class="text-xs text-gray-600">延迟退房</div>
    </div>
    <div class="text-center">
      <div class="text-sm font-medium text-amber-800">🍽 部分9折</div>
      <div class="text-xs text-gray-600">尊享餐饮</div>
    </div>
    <div class="text-center">
      <div class="text-sm font-medium text-amber-800">🏠 第5晚免费</div>
      <div class="text-xs text-gray-600">奖励住宿</div>
    </div>
  </div>
  
  <div class="mt-3 text-center">
    <span class="text-red-600 font-bold">品牌红包</span>
    <span class="text-sm text-gray-600">注册会员可领取80元红包</span>
  </div>
  
  <div class="mt-3 text-center">
    <%= link_to policy_hotel_path(@hotel), class: "text-blue-600 text-sm underline" do %>
      订房必读 · 酒店政策
    <% end %>
  </div>
</div>

<!-- 日期选择和客房预览 -->
<div class="bg-white border-t border-gray-100">
  <div class="p-4 border-b border-gray-100">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <div class="text-center">
          <div class="text-sm text-gray-600"><%= date_label(@check_in) %></div>
          <div class="text-lg font-bold"><%= @check_in.is_a?(String) ? Date.parse(@check_in).strftime('%m月%d日') : @check_in.strftime('%m月%d日') %></div>
          <div class="w-8 h-8 mx-auto mt-1 bg-orange-500 text-white rounded-full flex items-center justify-center text-xs"><%= (@check_out.to_date - @check_in.to_date).to_i %>晚</div>
        </div>
        <div class="text-center">
          <div class="text-sm text-gray-600"><%= date_label(@check_out) %></div>
          <div class="text-lg font-bold"><%= @check_out.is_a?(String) ? Date.parse(@check_out).strftime('%m月%d日') : @check_out.strftime('%m月%d日') %></div>
          <div class="text-xs text-gray-600 mt-1">看低价</div>
        </div>
      </div>
      <div class="flex items-center space-x-4">
        <div class="text-center">
          <div class="w-8 h-8 mx-auto bg-orange-100 rounded-full flex items-center justify-center">
            <span class="text-orange-500 font-bold"><%= @rooms %></span>
          </div>
          <div class="text-xs text-gray-600 mt-1">间</div>
        </div>
        <div class="text-center">
          <div class="w-8 h-8 mx-auto bg-orange-100 rounded-full flex items-center justify-center">
            <span class="text-orange-500 font-bold"><%= @adults %></span>
          </div>
          <div class="text-xs text-gray-600 mt-1">人</div>
        </div>
        <div class="text-center">
          <div class="w-8 h-8 mx-auto bg-gray-100 rounded-full flex items-center justify-center">
            <span class="text-gray-500 font-bold"><%= @children %></span>
          </div>
          <div class="text-xs text-gray-600 mt-1">儿童</div>
        </div>
      </div>
    </div>
  </div>

  <!-- 筛选标签 -->
  
</div>