<!-- 定制旅游首页 -->
<div class="min-h-screen bg-[#FFF9E6]" data-controller="custom-travel-modal">
  <!-- Header -->
  <div class="sticky top-0 z-40 bg-white shadow-sm">
    <div class="max-w-md mx-auto px-4 py-3 flex items-center justify-center relative">
      <button onclick="history.back()" class="absolute left-4 p-2 -ml-2">
        <%= image_tag 'https://img.alicdn.com/imgextra/i3/O1CN01aj4qjN1YHZKwZ6F2F_!!6000000003034-2-tps-48-48.png', class: 'w-6 h-6', alt: '返回' %>
      </button>
      <h1 class="text-lg font-bold text-gray-900" style="font-family: 'PingFang SC', sans-serif;">飞猪定制游</h1>
      <button class="absolute right-4 p-2 -mr-2">
        <%= image_tag 'https://img.alicdn.com/imgextra/i4/O1CN01wvLPGt1qH5FqZkBqe_!!6000000005470-2-tps-48-48.png', class: 'w-5 h-5', alt: '更多' %>
      </button>
    </div>
  </div>

  <!-- Tabs -->
  <div class="bg-white border-b border-gray-100">
    <div class="max-w-md mx-auto px-4">
      <div class="flex">
        <button class="flex-1 py-3 text-center font-medium border-b-2 border-[#FFD700] text-gray-900">
          个人定制
        </button>
        <button class="flex-1 py-3 text-center font-medium text-gray-500">
          公司团建
        </button>
      </div>
    </div>
  </div>

  <!-- Tab Content - 个人定制 -->
  <div class="max-w-md mx-auto">
    <!-- 个人定制描述 -->
    <div class="px-4 py-3 text-center">
      <p class="text-sm text-gray-600">家庭·亲子·情侣·朋友·闺蜜</p>
    </div>

    <!-- 选择目的地 -->
    <div class="px-4 pb-3">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base font-bold text-gray-900">选择目的地</h2>
        <button class="flex items-center text-sm text-gray-600">
          更多目的地
          <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>

      <!-- 目的地选项 - 第一行（免签） -->
      <div class="mb-3">
        <div class="text-xs text-gray-500 mb-2 flex items-center">
          <span class="mr-1">免签</span>
        </div>
        <div class="grid grid-cols-4 gap-2">
          <!-- 马来西亚 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm">
            <div class="relative aspect-square">
              <%= image_tag 'https://images.unsplash.com/photo-1596422846543-75c6fc197f07?w=200&h=200&fit=crop', 
                  class: 'w-full h-full object-cover', alt: '马来西亚' %>
              <div class="absolute top-1 right-1 bg-[#FF6B6B] text-white text-xs px-1.5 py-0.5 rounded">
                雨林暖阳
              </div>
            </div>
            <div class="p-2 text-center">
              <div class="text-sm font-medium text-gray-900">马来西亚</div>
            </div>
          </div>

          <!-- 日本 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm relative">
            <div class="relative aspect-square">
              <%= image_tag 'https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=200&h=200&fit=crop', 
                  class: 'w-full h-full object-cover', alt: '日本' %>
              <div class="absolute top-1 right-1 bg-[#FF9F45] text-white text-xs px-1.5 py-0.5 rounded flex items-center">
                <svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                枫雪温泉
              </div>
              <!-- 选中标记 -->
              <div class="absolute inset-0 border-2 border-[#FFD700] rounded-xl"></div>
              <div class="absolute bottom-1 right-1 bg-[#FFD700] rounded-full p-1">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
            </div>
            <div class="p-2 text-center">
              <div class="text-sm font-medium text-gray-900">日本</div>
            </div>
          </div>

          <!-- 巴厘岛 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm">
            <div class="relative aspect-square">
              <%= image_tag 'https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=200&h=200&fit=crop', 
                  class: 'w-full h-full object-cover', alt: '巴厘岛' %>
              <div class="absolute top-1 right-1 bg-[#4ECDC4] text-white text-xs px-1.5 py-0.5 rounded">
                海岛暖冬
              </div>
            </div>
            <div class="p-2 text-center">
              <div class="text-sm font-medium text-gray-900">巴厘岛</div>
            </div>
          </div>

          <!-- 冰岛 -->
          <div class="bg-white rounded-xl overflow-hidden shadow-sm">
            <div class="relative aspect-square">
              <%= image_tag 'https://images.unsplash.com/photo-1504893524553-b855bce32c67?w=200&h=200&fit=crop', 
                  class: 'w-full h-full object-cover', alt: '冰岛' %>
              <div class="absolute top-1 right-1 bg-[#6C63FF] text-white text-xs px-1.5 py-0.5 rounded">
                极光秘境
              </div>
            </div>
            <div class="p-2 text-center">
              <div class="text-sm font-medium text-gray-900">冰岛</div>
            </div>
          </div>
        </div>
      </div>

      <!-- 目的地选项 - 第二行（国内） -->
      <div class="grid grid-cols-4 gap-2">
        <!-- 云南 -->
        <div class="bg-white rounded-xl overflow-hidden shadow-sm">
          <div class="relative aspect-square">
            <%= image_tag 'https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=200&h=200&fit=crop', 
                class: 'w-full h-full object-cover', alt: '云南' %>
            <div class="absolute top-1 right-1 bg-[#FF6B9D] text-white text-xs px-1.5 py-0.5 rounded flex items-center">
              <svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              暖冬赏花
            </div>
          </div>
          <div class="p-2 text-center">
            <div class="text-sm font-medium text-gray-900">云南</div>
          </div>
        </div>

        <!-- 北京 -->
        <div class="bg-white rounded-xl overflow-hidden shadow-sm">
          <div class="relative aspect-square">
            <%= image_tag 'https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=200&h=200&fit=crop', 
                class: 'w-full h-full object-cover opacity-90', alt: '北京' %>
            <div class="absolute top-1 right-1 bg-[#B4C7E7] text-white text-xs px-1.5 py-0.5 rounded flex items-center">
              <svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z" clip-rule="evenodd"/>
              </svg>
              雪韵古都
            </div>
          </div>
          <div class="p-2 text-center">
            <div class="text-sm font-medium text-gray-900">北京</div>
          </div>
        </div>

        <!-- 海南 -->
        <div class="bg-white rounded-xl overflow-hidden shadow-sm">
          <div class="relative aspect-square">
            <%= image_tag 'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=200&h=200&fit=crop', 
                class: 'w-full h-full object-cover', alt: '海南' %>
            <div class="absolute top-1 right-1 bg-[#4ECDC4] text-white text-xs px-1.5 py-0.5 rounded flex items-center">
              <svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.5 17a4.5 4.5 0 01-1.44-8.765 4.5 4.5 0 018.302-3.046 3.5 3.5 0 014.504 4.272A4 4 0 0115 17H5.5zm3.75-9.25a.75.75 0 001.5 0V4.56l1.22 1.22a.75.75 0 101.06-1.06l-2.5-2.5a.75.75 0 00-1.06 0l-2.5 2.5a.75.75 0 001.06 1.06l1.22-1.22v3.19z" clip-rule="evenodd"/>
              </svg>
              避寒天堂
            </div>
          </div>
          <div class="p-2 text-center">
            <div class="text-sm font-medium text-gray-900">海南</div>
          </div>
        </div>

        <!-- 北海 -->
        <div class="bg-white rounded-xl overflow-hidden shadow-sm">
          <div class="relative aspect-square">
            <%= image_tag 'https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=200&h=200&fit=crop', 
                class: 'w-full h-full object-cover', alt: '北海' %>
            <div class="absolute top-1 right-1 bg-[#95E1D3] text-white text-xs px-1.5 py-0.5 rounded">
              银滩暖阳
            </div>
          </div>
          <div class="p-2 text-center">
            <div class="text-sm font-medium text-gray-900">北海</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 免费获取方案按钮 -->
    <div class="px-4 py-4">
      <button 
        type="button"
        data-action="click->custom-travel-modal#open"
        class="w-full py-4 rounded-full text-lg font-bold text-black shadow-lg transition-all hover:shadow-xl" 
        style="background: linear-gradient(135deg, #FFD700 0%, #FFC700 100%);">
        免费获取方案
      </button>
      <p class="text-center text-xs text-gray-500 mt-2">专属方案 · 独立成团 · 会心省力 · 全程服务</p>
    </div>

    <!-- 步骤流程 -->
    <div class="px-4 pb-6">
      <div class="flex items-center justify-between text-center">
        <div class="flex-1">
          <div class="w-10 h-10 mx-auto mb-1 rounded-full bg-[#FFD700] text-black font-bold text-lg flex items-center justify-center">
            1
          </div>
          <p class="text-xs text-gray-600">选旅游目的地</p>
        </div>
        <div class="flex-1 -mt-6">
          <svg class="w-8 h-8 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="flex-1">
          <div class="w-10 h-10 mx-auto mb-1 rounded-full bg-[#FFD700] text-black font-bold text-lg flex items-center justify-center">
            2
          </div>
          <p class="text-xs text-gray-600">免费定制咨询</p>
        </div>
        <div class="flex-1 -mt-6">
          <svg class="w-8 h-8 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="flex-1">
          <div class="w-10 h-10 mx-auto mb-1 rounded-full bg-[#FFD700] text-black font-bold text-lg flex items-center justify-center">
            3
          </div>
          <p class="text-xs text-gray-600">不限次免费改</p>
        </div>
        <div class="flex-1 -mt-6">
          <svg class="w-8 h-8 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="flex-1">
          <div class="w-10 h-10 mx-auto mb-1 rounded-full bg-[#FFD700] text-black font-bold text-lg flex items-center justify-center">
            4
          </div>
          <p class="text-xs text-gray-600">满意后再付款</p>
        </div>
      </div>
    </div>

    <!-- 精选定制玩法 -->
    <div class="bg-white py-6">
      <div class="px-4">
        <h2 class="text-lg font-bold text-gray-900 mb-4">精选定制玩法</h2>
        
        <!-- 玩法分类 -->
        <div class="flex gap-2 mb-4 overflow-x-auto hide-scrollbar pb-1">
          <button class="px-4 py-2 rounded-full text-sm font-bold whitespace-nowrap" style="background: #FFD700;">
            春节推荐
          </button>
          <button class="px-4 py-2 rounded-full bg-gray-100 text-sm font-medium whitespace-nowrap text-gray-700">
            云贵川
          </button>
          <button class="px-4 py-2 rounded-full bg-gray-100 text-sm font-medium whitespace-nowrap text-gray-700">
            北京
          </button>
          <button class="px-4 py-2 rounded-full bg-gray-100 text-sm font-medium whitespace-nowrap text-gray-700">
            出境
          </button>
          <button class="px-4 py-2 rounded-full bg-gray-100 text-sm font-medium whitespace-nowrap text-gray-700">
            亲子
          </button>
        </div>

        <!-- 玩法卡片 -->
        <div class="grid grid-cols-2 gap-3">
          <!-- 卡片1 - 私家定制小团北京旅游 -->
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
            <div class="relative h-40">
              <%= image_tag 'https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=400&h=300&fit=crop', 
                  class: 'w-full h-full object-cover', alt: '北京旅游' %>
            </div>
            <div class="p-3">
              <h3 class="text-sm font-medium leading-tight mb-2 line-clamp-2 min-h-[40px]">
                【私家定制小团北京旅游】故宫天安门长城环...
              </h3>
              <span class="inline-block bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded mb-2">
                专业定制车队
              </span>
              <div class="flex items-center justify-between">
                <span class="text-red-500 font-bold text-base">¥1588起</span>
                <span class="text-xs text-gray-400">已售234</span>
              </div>
            </div>
          </div>

          <!-- 卡片2 - 不费妈100%纯玩私人定制旅行团 -->
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
            <div class="relative h-40">
              <%= image_tag 'https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=400&h=300&fit=crop', 
                  class: 'w-full h-full object-cover', alt: '云南旅游' %>
            </div>
            <div class="p-3">
              <h3 class="text-sm font-medium leading-tight mb-2 line-clamp-2 min-h-[40px]">
                【不费妈100%纯玩私人定制旅行团】云南旅游团昆...
              </h3>
              <span class="inline-block bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded mb-2">
                纯玩无购物
              </span>
              <div class="flex items-center justify-between">
                <span class="text-red-500 font-bold text-base">¥2688起</span>
                <span class="text-xs text-gray-400">已售456</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 我的定制单 -->
    <div class="px-4 py-6 pb-20">
      <%= link_to my_orders_custom_travel_requests_path, class: "flex items-center justify-center py-4 bg-white rounded-xl shadow-sm border border-gray-200" do %>
        <svg class="w-5 h-5 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <span class="text-base font-medium text-gray-700">我的定制单</span>
      <% end %>
    </div>
  </div>

  <!-- Custom Travel Modal -->
  <%= render 'shared/custom_travel_modal' %>

  <!-- Bottom Navigation -->
  <%= render 'shared/bottom_navigation' %>
</div>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
