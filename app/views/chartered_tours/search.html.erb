<!-- 包车游主页 - 城市选择、日期选择、路线展示 -->
<div class="min-h-screen bg-background" data-controller="charter-search date-picker">
  <!-- Header Banner -->
  <div class="bg-gradient-to-br from-yellow-50 via-yellow-100 to-yellow-50 border-b border-yellow-200">
    <div class="max-w-md mx-auto px-4 py-4">
      <!-- Back Button & Title -->
      <div class="flex items-center justify-between mb-4">
        <button onclick="history.back()" class="p-2 -ml-2">
          <%= image_tag '返回.png', class: 'w-6 h-6', alt: '返回' %>
        </button>
        <h1 class="text-lg font-bold text-text-primary">全球包车游</h1>
        <button class="p-2 -mr-2">
          <%= image_tag '更多.png', class: 'w-5 h-5', alt: '更多' %>
        </button>
      </div>

      <!-- Subtitle -->
      <div class="flex items-center justify-center text-sm text-text-secondary mb-3">
        <span>靠谱司机 中文服务 精挑路线</span>
        <svg class="w-4 h-4 ml-1 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </div>

      <!-- City Selector -->
      <div class="bg-white rounded-xl shadow-sm p-4 mb-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center text-text-secondary text-sm">
            <svg class="w-5 h-5 text-red-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            包车城市
          </div>
          <button 
            type="button"
            data-action="click->charter-search#openCitySelector"
            class="flex items-center text-text-primary font-medium">
            <span data-charter-search-target="cityName"><%= @selected_city&.name || '武汉' %></span>
            <svg class="w-5 h-5 ml-1 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Hot Cities -->
      <div class="mb-3">
        <div class="text-xs text-text-secondary mb-2 flex items-center">
          <span class="mr-1">热门：</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <% ['北京', '上海', '成都', '东京', '曼谷', '巴黎', '纽约', '悉尼'].each do |city_name| %>
            <button 
              type="button"
              data-action="click->charter-search#selectHotCity"
              data-city-name="<%= city_name %>"
              class="px-3 py-1.5 bg-white text-text-secondary text-xs rounded-full border border-divider hover:border-primary hover:text-primary transition-colors">
              <%= city_name %>
            </button>
          <% end %>
        </div>
      </div>

      <!-- Departure Date -->
      <div class="bg-white rounded-xl shadow-sm p-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center text-text-secondary text-sm">
            <svg class="w-5 h-5 text-blue-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            出发日期
          </div>
          <button 
            type="button"
            data-action="click->date-picker#openModal"
            class="flex items-center text-text-primary font-medium">
            <span data-charter-search-target="dateDisplay"><%= @departure_date.strftime('%m月%d日') %> 出发</span>
            <svg class="w-5 h-5 ml-1 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- CTA Button -->
      <button 
        type="button"
        data-action="click->charter-search#startBooking"
        class="w-full mt-4 py-4 rounded-full text-base font-bold text-text-inverse shadow-lg transition-all hover:shadow-xl bg-gradient-to-r from-yellow-400 to-yellow-500 hover:from-yellow-500 hover:to-yellow-600">
        立即包车
      </button>
    </div>
  </div>

  <!-- Routes Section -->
  <div class="max-w-md mx-auto">
    <!-- Routes Title -->
    <div class="px-4 py-4 bg-white">
      <h2 class="text-base font-bold text-text-primary mb-1">
        <span class="text-primary"><%= @selected_city&.name || '武汉' %></span>精挑路线
      </h2>
      <% if @city_attractions.any? %>
        <p class="text-xs text-text-secondary">含<%= @city_attractions.take(3).map(&:name).join('/') %>等</p>
      <% else %>
        <p class="text-xs text-text-secondary">探索当地精选景点</p>
      <% end %>
    </div>

    <!-- Routes Grid -->
    <div class="px-4 pb-4 bg-white">
      <div class="grid grid-cols-3 gap-3">
        <% if @routes.any? %>
          <% @routes.take(3).each do |route| %>
            <%= link_to charter_route_path(route, departure_date: @departure_date.strftime('%Y-%m-%d')), 
                class: "block bg-surface-elevated rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" do %>
              <div class="aspect-square relative">
                <img src="https://images.unsplash.com/photo-1548013146-72479768bada?w=300&h=300&fit=crop" 
                     alt="<%= route.name %>" 
                     class="w-full h-full object-cover">
              </div>
              <div class="p-2">
                <h3 class="text-sm font-medium text-text-primary mb-1 line-clamp-2"><%= route.name %></h3>
                <div class="text-xs text-text-secondary mb-1">
                  <%= route.attractions.pluck(:name).take(2).join('/') %>...
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="col-span-3 text-center py-8 text-text-secondary">
            暂无路线数据
          </div>
        <% end %>
      </div>
    </div>

    <!-- Attractions Section -->
    <% if @city_attractions.any? %>
      <div class="bg-white mt-2 pb-4">
        <% @city_attractions.take(5).each_with_index do |attraction, index| %>
          <div class="px-4 py-4 flex items-center justify-between <%= 'border-t border-divider' if index > 0 %>">
            <h3 class="text-sm font-semibold text-text-primary"><%= attraction.name %></h3>
            <% if attraction.description.present? %>
              <span class="text-xs text-text-tertiary"><%= attraction.description.truncate(20) %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Tabs Section -->
    <div class="bg-white mt-2">
      <div class="flex border-b border-divider" data-charter-search-target="tabButtons">
        <% recommend_cls = @active_tab == 'recommend' ? 'text-primary border-b-2 border-primary' : 'text-text-secondary' %>
        <% classic_cls = @active_tab == 'classic' ? 'text-primary border-b-2 border-primary' : 'text-text-secondary' %>
        <% hot_cls = @active_tab == 'hot' ? 'text-primary border-b-2 border-primary' : 'text-text-secondary' %>
        
        <button type="button" data-action="click->charter-search#switchTab" data-tab="recommend" class="flex-1 py-3 text-center text-sm font-medium transition-colors <%= recommend_cls %>">
          猜你喜欢
        </button>
        <button type="button" data-action="click->charter-search#switchTab" data-tab="classic" class="flex-1 py-3 text-center text-sm font-medium transition-colors <%= classic_cls %>">
          经典路线
        </button>
        <button type="button" data-action="click->charter-search#switchTab" data-tab="hot" class="flex-1 py-3 text-center text-sm font-medium transition-colors <%= hot_cls %>">
          热门路线
        </button>
      </div>

      <!-- Tab Content - Route Cards -->
      <div class="p-4">
        <!-- Recommend Tab Content -->
        <div data-charter-search-target="tabContent" data-tab="recommend" class="<%= @active_tab == 'recommend' ? '':  'hidden' %>">
          <% recommend_routes = @selected_city ? CharterRoute.where(city: @selected_city).featured.includes(:city, :attractions).order(:name) : CharterRoute.none %>
          <% if recommend_routes.any? %>
            <div class="space-y-3">
              <% recommend_routes.each do |route| %>
                <%= link_to charter_route_path(route, departure_date: @departure_date.strftime('%Y-%m-%d')), 
                    class: "block" do %>
                  <div class="flex bg-surface-elevated rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-32 h-32 flex-shrink-0">
                      <img src="https://images.unsplash.com/photo-1548013146-72479768bada?w=300&h=300&fit=crop" 
                           alt="<%= route.name %>" 
                           class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1 p-3 flex flex-col justify-between">
                      <div>
                        <h4 class="text-sm font-semibold text-text-primary mb-1 line-clamp-2"><%= route.name %></h4>
                        <div class="text-xs text-text-secondary mb-2">
                          <% if route.attractions.any? %>
                            <%= route.attractions.pluck(:name).take(3).join(' · ') %>
                          <% end %>
                        </div>
                      </div>
                      <div class="flex items-end justify-between">
                        <div>
                          <span class="text-xs text-text-secondary">起</span>
                          <span class="text-lg font-bold text-primary">¥<%= @route_prices[route.id]&.round(2) || route.price_from %></span>
                          <span class="text-xs text-text-secondary">/6h</span>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <svg class="w-16 h-16 text-text-disabled mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <p class="text-text-secondary">暂无路线，换个城市看看吧～</p>
            </div>
          <% end %>
        </div>

        <!-- Classic Tab Content -->
        <div data-charter-search-target="tabContent" data-tab="classic" class="<%= @active_tab != 'classic' ? 'hidden' : '' %>">
          <% classic_routes = @selected_city ? CharterRoute.where(city: @selected_city).classic.includes(:city, :attractions).order(:name) : CharterRoute.none %>
          <% if classic_routes.any? %>
            <div class="space-y-3">
              <% classic_routes.each do |route| %>
                <%= link_to charter_route_path(route, departure_date: @departure_date.strftime('%Y-%m-%d')), 
                    class: "block" do %>
                  <div class="flex bg-surface-elevated rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-32 h-32 flex-shrink-0">
                      <img src="https://images.unsplash.com/photo-1548013146-72479768bada?w=300&h=300&fit=crop" 
                           alt="<%= route.name %>" 
                           class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1 p-3 flex flex-col justify-between">
                      <div>
                        <h4 class="text-sm font-semibold text-text-primary mb-1 line-clamp-2"><%= route.name %></h4>
                        <div class="text-xs text-text-secondary mb-2">
                          <% if route.attractions.any? %>
                            <%= route.attractions.pluck(:name).take(3).join(' · ') %>
                          <% end %>
                        </div>
                      </div>
                      <div class="flex items-end justify-between">
                        <div>
                          <span class="text-xs text-text-secondary">起</span>
                          <span class="text-lg font-bold text-primary">¥<%= @route_prices[route.id]&.round(2) || route.price_from %></span>
                          <span class="text-xs text-text-secondary">/6h</span>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <svg class="w-16 h-16 text-text-disabled mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <p class="text-text-secondary">暂无路线，换个城市看看吧～</p>
            </div>
          <% end %>
        </div>

        <!-- Hot Tab Content -->
        <div data-charter-search-target="tabContent" data-tab="hot" class="<%= @active_tab != 'hot' ? 'hidden' : '' %>">
          <% hot_routes = @selected_city ? CharterRoute.where(city: @selected_city).hot.includes(:city, :attractions).order(:name) : CharterRoute.none %>
          <% if hot_routes.any? %>
            <div class="space-y-3">
              <% hot_routes.each do |route| %>
                <%= link_to charter_route_path(route, departure_date: @departure_date.strftime('%Y-%m-%d')), 
                    class: "block" do %>
                  <div class="flex bg-surface-elevated rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                    <div class="w-32 h-32 flex-shrink-0">
                      <img src="https://images.unsplash.com/photo-1548013146-72479768bada?w=300&h=300&fit=crop" 
                           alt="<%= route.name %>" 
                           class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1 p-3 flex flex-col justify-between">
                      <div>
                        <h4 class="text-sm font-semibold text-text-primary mb-1 line-clamp-2"><%= route.name %></h4>
                        <div class="text-xs text-text-secondary mb-2">
                          <% if route.attractions.any? %>
                            <%= route.attractions.pluck(:name).take(3).join(' · ') %>
                          <% end %>
                        </div>
                      </div>
                      <div class="flex items-end justify-between">
                        <div>
                          <span class="text-xs text-text-secondary">起</span>
                          <span class="text-lg font-bold text-primary">¥<%= @route_prices[route.id]&.round(2) || route.price_from %></span>
                          <span class="text-xs text-text-secondary">/6h</span>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <svg class="w-16 h-16 text-text-disabled mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
              <p class="text-text-secondary">暂无路线，换个城市看看吧～</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- City Selector Modal (Hidden by default) -->
  <div data-charter-search-target="cityModal" class="hidden fixed inset-0 bg-black/50 z-50" data-action="click->charter-search#closeOnBackdrop">
    <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl max-h-[80vh] overflow-hidden flex flex-col">
      <!-- Modal Header -->
      <div class="sticky top-0 bg-white border-b border-divider px-4 py-3 flex items-center justify-between z-10">
        <h3 class="text-base font-bold text-text-primary">选择城市</h3>
        <button type="button" data-action="click->charter-search#closeCitySelector" class="p-1">
          <svg class="w-6 h-6 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      
      <!-- Search Box -->
      <div class="px-4 py-3 border-b border-divider bg-surface">
        <div class="relative">
          <input 
            type="text" 
            data-charter-search-target="searchInput"
            data-action="input->charter-search#filterCities"
            placeholder="搜索城市名称..."
            class="w-full pl-10 pr-4 py-2 border border-divider rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </div>
      
      <!-- Cities List (Scrollable) -->
      <div class="flex-1 overflow-y-auto" data-charter-search-target="citiesList">
        <% @cities_by_region.each do |region, cities| %>
          <div class="city-group" data-region="<%= region %>">
            <div class="sticky top-0 bg-surface px-4 py-2 text-xs font-semibold text-text-secondary uppercase tracking-wider z-10">
              <%= region %>
            </div>
            <div class="grid grid-cols-3 gap-2 px-4 py-2">
              <% cities.each do |city| %>
                <button 
                  type="button"
                  data-action="click->charter-search#selectCity"
                  data-city-name="<%= city.name %>"
                  class="city-item py-2.5 text-center text-sm font-medium bg-white text-text-primary rounded-lg hover:bg-primary hover:text-white transition-colors border border-divider"
                  data-city-pinyin="<%= city.pinyin %>"
                  data-city-display="<%= city.name %>">
                  <%= city.name %>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= render 'shared/date_picker_modal' %>
</div>
