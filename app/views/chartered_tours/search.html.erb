<!-- 包车游主页 - 城市选择、日期选择、路线展示 -->
<div class="min-h-screen bg-background" data-controller="charter-search">
  <!-- Header Banner -->
  <div class="bg-gradient-to-br from-yellow-50 via-yellow-100 to-yellow-50 border-b border-yellow-200">
    <div class="max-w-md mx-auto px-4 py-4">
      <!-- Back Button & Title -->
      <div class="flex items-center justify-between mb-4">
        <button onclick="history.back()" class="p-2 -ml-2">
          <%= image_tag '返回.png', class: 'w-6 h-6', alt: '返回' %>
        </button>
        <h1 class="text-lg font-bold text-text-primary">全球包车游</h1>
        <button class="p-2 -mr-2">
          <%= image_tag '更多.png', class: 'w-5 h-5', alt: '更多' %>
        </button>
      </div>

      <!-- Subtitle -->
      <div class="flex items-center justify-center text-sm text-text-secondary mb-3">
        <span>靠谱司机 中文服务 精挑路线</span>
        <svg class="w-4 h-4 ml-1 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </div>

      <!-- City Selector -->
      <div class="bg-white rounded-xl shadow-sm p-4 mb-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center text-text-secondary text-sm">
            <svg class="w-5 h-5 text-red-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            包车城市
          </div>
          <button 
            type="button"
            data-action="click->charter-search#openCitySelector"
            class="flex items-center text-text-primary font-medium">
            <span data-charter-search-target="cityName"><%= @selected_city&.name || '武汉' %></span>
            <svg class="w-5 h-5 ml-1 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Hot Cities -->
      <div class="mb-3">
        <div class="text-xs text-text-secondary mb-2 flex items-center">
          <span class="mr-1">热门：</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <% ['东京', '大阪', '京都', '冲绳', '富山'].each do |city_name| %>
            <button 
              type="button"
              data-action="click->charter-search#selectHotCity"
              data-city-name="<%= city_name %>"
              class="px-3 py-1.5 bg-white text-text-secondary text-xs rounded-full border border-divider hover:border-primary hover:text-primary transition-colors">
              <%= city_name %>
            </button>
          <% end %>
        </div>
      </div>

      <!-- Departure Date -->
      <div class="bg-white rounded-xl shadow-sm p-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center text-text-secondary text-sm">
            <svg class="w-5 h-5 text-blue-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            出发日期
          </div>
          <button 
            type="button"
            data-action="click->charter-search#openDatePicker"
            class="flex items-center text-text-primary font-medium">
            <span data-charter-search-target="dateDisplay"><%= @departure_date.strftime('%m月%d日') %> 出发</span>
            <svg class="w-5 h-5 ml-1 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- CTA Button -->
      <button 
        type="button"
        data-action="click->charter-search#startBooking"
        class="w-full mt-4 py-4 rounded-full text-base font-bold text-text-inverse shadow-lg transition-all hover:shadow-xl bg-gradient-to-r from-yellow-400 to-yellow-500 hover:from-yellow-500 hover:to-yellow-600">
        立即包车
      </button>
    </div>
  </div>

  <!-- Routes Section -->
  <div class="max-w-md mx-auto">
    <!-- Routes Title -->
    <div class="px-4 py-4 bg-white">
      <h2 class="text-base font-bold text-text-primary mb-1">
        <span class="text-primary"><%= @selected_city&.name || '武汉' %></span>精挑路线
      </h2>
      <p class="text-xs text-text-secondary">含黄鹤楼/湖北省博物馆/武汉大学等</p>
    </div>

    <!-- Routes Grid -->
    <div class="px-4 pb-4 bg-white">
      <div class="grid grid-cols-3 gap-3">
        <% if @routes.any? %>
          <% @routes.take(3).each do |route| %>
            <%= link_to charter_route_path(route, departure_date: @departure_date), 
                class: "block bg-surface-elevated rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" do %>
              <div class="aspect-square relative">
                <img src="https://images.unsplash.com/photo-1548013146-72479768bada?w=300&h=300&fit=crop" 
                     alt="<%= route.name %>" 
                     class="w-full h-full object-cover">
              </div>
              <div class="p-2">
                <h3 class="text-sm font-medium text-text-primary mb-1 line-clamp-2"><%= route.name %></h3>
                <div class="text-xs text-text-secondary mb-1">
                  <%= route.attractions.pluck(:name).take(2).join('/') %>...
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="col-span-3 text-center py-8 text-text-secondary">
            暂无路线数据
          </div>
        <% end %>
      </div>
    </div>

    <!-- Attractions Section -->
    <div class="bg-white mt-2 pb-4">
      <div class="px-4 py-4 flex items-center justify-between">
        <h3 class="text-sm font-semibold text-text-primary">黄鹤楼</h3>
        <span class="text-xs text-text-tertiary">江南三大名楼,仙鹤...</span>
      </div>
      <div class="px-4 py-4 flex items-center justify-between border-t border-divider">
        <h3 class="text-sm font-semibold text-text-primary">湖北省博物馆</h3>
        <span class="text-xs text-text-tertiary">编钟表演,浓郁楚...</span>
      </div>
      <div class="px-4 py-4 flex items-center justify-between border-t border-divider">
        <h3 class="text-sm font-semibold text-text-primary">武汉大学</h3>
        <span class="text-xs text-text-tertiary">特色老建筑群,赏...</span>
      </div>
    </div>

    <!-- Tabs Section -->
    <div class="bg-white mt-2">
      <div class="flex border-b border-divider">
        <%= link_to search_chartered_tours_path(city: @selected_city&.name, date: @departure_date, tab: 'recommend'),
            class: "flex-1 py-3 text-center text-sm font-medium transition-colors #{@active_tab == 'recommend' ? 'text-primary border-b-2 border-primary' : 'text-text-secondary'}" do %>
          猜你喜欢
        <% end %>
        <%= link_to search_chartered_tours_path(city: @selected_city&.name, date: @departure_date, tab: 'classic'),
            class: "flex-1 py-3 text-center text-sm font-medium transition-colors #{@active_tab == 'classic' ? 'text-primary border-b-2 border-primary' : 'text-text-secondary'}" do %>
          经典路线
        <% end %>
        <%= link_to search_chartered_tours_path(city: @selected_city&.name, date: @departure_date, tab: 'hot'),
            class: "flex-1 py-3 text-center text-sm font-medium transition-colors #{@active_tab == 'hot' ? 'text-primary border-b-2 border-primary' : 'text-text-secondary'}" do %>
          热门路线
        <% end %>
      </div>

      <!-- Tab Content - Route Cards -->
      <div class="p-4">
        <% if @routes.any? %>
          <div class="space-y-3">
            <% @routes.each do |route| %>
              <%= link_to charter_route_path(route, departure_date: @departure_date), 
                  class: "block" do %>
                <div class="flex bg-surface-elevated rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                  <div class="w-32 h-32 flex-shrink-0">
                    <img src="https://images.unsplash.com/photo-1548013146-72479768bada?w=300&h=300&fit=crop" 
                         alt="<%= route.name %>" 
                         class="w-full h-full object-cover">
                  </div>
                  <div class="flex-1 p-3 flex flex-col justify-between">
                    <div>
                      <h4 class="text-sm font-semibold text-text-primary mb-1 line-clamp-2"><%= route.name %></h4>
                      <div class="text-xs text-text-secondary mb-2">
                        <% if route.attractions.any? %>
                          <%= route.attractions.pluck(:name).take(3).join(' · ') %>
                        <% end %>
                      </div>
                    </div>
                    <div class="flex items-end justify-between">
                      <div>
                        <span class="text-xs text-text-secondary">起</span>
                        <span class="text-lg font-bold text-primary">¥<%= route.price_from %></span>
                        <span class="text-xs text-text-secondary">/6h</span>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <svg class="w-16 h-16 text-text-disabled mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            <p class="text-text-secondary">暂无路线，换个城市看看吧～</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- City Selector Modal (Hidden by default) -->
  <div data-charter-search-target="cityModal" class="hidden fixed inset-0 bg-black/50 z-50">
    <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl max-h-[70vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-divider px-4 py-3 flex items-center justify-between">
        <h3 class="text-base font-bold text-text-primary">选择城市</h3>
        <button type="button" data-action="click->charter-search#closeCitySelector" class="p-1">
          <svg class="w-6 h-6 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="p-4">
        <% if @hot_cities.any? %>
          <div class="grid grid-cols-3 gap-3">
            <% @hot_cities.each do |city| %>
              <button 
                type="button"
                data-action="click->charter-search#selectCity"
                data-city-name="<%= city.name %>"
                class="py-3 text-center text-sm font-medium bg-surface-elevated text-text-primary rounded-lg hover:bg-surface-hover transition-colors">
                <%= city.name %>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Date Picker Modal (Hidden by default) -->
  <div data-charter-search-target="dateModal" class="hidden fixed inset-0 bg-black/50 z-50">
    <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl">
      <div class="sticky top-0 bg-white border-b border-divider px-4 py-3 flex items-center justify-between">
        <h3 class="text-base font-bold text-text-primary">选择出发日期</h3>
        <button type="button" data-action="click->charter-search#closeDatePicker" class="p-1">
          <svg class="w-6 h-6 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-7 gap-2 mb-4">
          <% 14.times do |i| %>
            <% date = Date.current + i.days %>
            <button 
              type="button"
              data-action="click->charter-search#selectDate"
              data-date="<%= date.strftime('%Y-%m-%d') %>"
              class="py-3 text-center text-xs flex flex-col items-center rounded-lg <%= date == @departure_date ? 'bg-primary text-text-inverse' : 'bg-surface-elevated text-text-primary hover:bg-surface-hover' %> transition-colors">
              <span class="font-medium"><%= date.strftime('%d') %></span>
              <span class="text-xs opacity-75"><%= date.strftime('%a') %></span>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
