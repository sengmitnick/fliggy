<div class="min-h-screen bg-gray-100" data-controller="city-selector date-picker return-date-picker trip-type passenger-selector cabin-selector multi-city" data-city-selector-departure-city-value="<%= params[:departure_city] || '北京' %>" data-city-selector-destination-city-value="<%= params[:destination_city] || '杭州' %>" data-date-picker-current-date-value="<%= Time.zone.today.to_s %>" data-return-date-picker-current-date-value="<%= (Time.zone.today + 1.day).to_s %>" data-return-date-picker-min-date-value="<%= Time.zone.today.to_s %>" data-multi-city-switch-icon-url-value="<%= asset_path('airfare/切换.png') %>">
  <!-- Header with Banner -->
  <div class="relative pb-8">
    <%= render 'shared/transport_header', background_image: '活动.png', return_path: root_path %>

    <!-- Tabs Container with Gray Background -->
    <div class="relative mx-4 -mt-3 overflow-hidden z-50">
      <%= render 'shared/transport_tabs', active_tab: :flight %>
  
      <!-- White Card Container with Form -->
      <div class="bg-white rounded-b-[24px] shadow-sm">
      <div>
    <!-- Trip Type Tabs -->
    <div class="flex items-center justify-center gap-8 py-4 border-b border-gray-100">
      <div class="flex-1 flex items-center justify-center">
        <button 
          type="button"
          data-trip-type-target="tab" 
          data-trip-type="one_way"
          data-action="click->trip-type#selectType"
          class="text-base font-bold border-b-2 border-black pb-1">
          单程
        </button>
      </div>
      <div class="flex-1 flex items-center justify-center">
        <button 
          type="button"
          data-trip-type-target="tab" 
          data-trip-type="round_trip"
          data-action="click->trip-type#selectType"
          class="text-base text-gray-500 relative">
          往返
          <span class="absolute -top-3 -right-6 bg-red-500 text-white text-xs px-1 rounded">更优惠</span>
        </button>
      </div>
      <div class="flex-1 flex items-center justify-center">
        <button 
          type="button"
          data-trip-type-target="tab" 
          data-trip-type="multi_city"
          data-action="click->trip-type#selectType"
          class="text-base text-gray-500">
          多程
        </button>
      </div>
    </div>

    <!-- Promotion Banner -->
    <div class="mx-4 my-3 px-3 py-2 rounded-lg flex items-center justify-between" style="background: linear-gradient(90deg, #FFF4E6 0%, #FFE8CC 100%);" data-trip-type-target="promotionBanner">
      <div class="flex items-center gap-2">
        <span class="text-sm font-bold" style="color: #FF6B35;">机酒联订更优惠</span>
        <span class="text-xs text-gray-600">购买国内机票立减<span class="font-bold text-red-500">20~30元</span></span>
      </div>
      <button class="text-gray-400">×</button>
    </div>

    <!-- Single/Round Trip Form -->
    <div class="mx-4 mb-4" data-trip-type-target="oneWayRoundTripForm">
      <div class="flex items-center justify-between mb-4">
        <button 
          data-action="click->city-selector#openDeparture"
          class="flex-1 text-left">
          <div class="text-[32px] font-bold leading-tight" data-city-selector-target="departure"><%= params[:departure_city] || '北京' %></div>
        </button>
        
        <button 
          data-action="click->city-selector#switchCities"
          class="mx-4 flex items-center justify-center">
          <%= image_tag "airfare/切换.png", class: "w-12 h-12", alt: "切换" %>
        </button>
        
        <button 
          data-action="click->city-selector#openDestination"
          class="flex-1 text-right">
          <div class="text-[32px] font-bold leading-tight" data-city-selector-target="destination"><%= params[:destination_city] || '杭州' %></div>
        </button>
      </div>

      <!-- Date Selection -->
      <div class="mb-4">
        <button 
          type="button"
          data-action="click->date-picker#openModal"
          class="text-left">
          <div class="text-[32px] font-bold flex items-baseline leading-none" data-date-picker-target="selectedDate">
            <%= Time.zone.today.month %><span class="text-lg font-medium mx-0.5">月</span><%= Time.zone.today.day %><span class="text-lg font-medium ml-0.5 mr-2">日</span>
            <span class="text-base text-gray-500 font-medium">今天</span>
          </div>
        </button>
      </div>

      <!-- Return Date Selection (hidden by default) -->
      <div class="mb-4 hidden" data-trip-type-target="returnDateSection">
        <button 
          type="button"
          data-action="click->return-date-picker#openModal"
          class="text-left">
          <div class="text-sm text-gray-500 mb-1">返程日期</div>
          <div class="text-[32px] font-bold flex items-baseline leading-none" data-return-date-picker-target="selectedDate">
            <%= (Time.zone.today + 197.days).month %><span class="text-lg font-medium mx-0.5">月</span><%= (Time.zone.today + 197.days).day %><span class="text-lg font-medium ml-0.5 mr-2">日</span>
            <span class="text-base text-gray-500 font-medium">周六</span>
          </div>
        </button>
      </div>

      <!-- Passenger Selection -->
      <button 
        type="button"
        data-action="click->passenger-selector#openModal"
        class="w-full flex items-center justify-between py-3 border-b border-gray-100">
        <div data-passenger-selector-target="selectedDisplay">
          <div class="text-base text-gray-800">选择乘机人</div>
          <div class="text-sm" style="color: #00A0E9;">快速找到低价票</div>
        </div>
        <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
      </button>

      <!-- Cabin Class Selection -->
      <div class="w-full flex">
        <div class="flex gap-1 rounded-sm bg-gray-950/5 px-1 py-1 w-full">
          <button 
            type="button"
            data-cabin-selector-target="button"
            data-cabin-type="all"
            data-action="click->cabin-selector#select"
            class="flex-1 px-4 py-2 rounded-sm text-sm font-medium transition-colors">
            全部舱位
          </button>
          <button 
            type="button"
            data-cabin-selector-target="button"
            data-cabin-type="business"
            data-action="click->cabin-selector#select"
            class="flex-1 px-4 py-2 rounded-sm text-sm font-medium transition-colors whitespace-nowrap">
            公务/头等舱
          </button>
        </div>
      </div>

      <!-- Search Button -->
      <%= form_with url: search_flights_path, method: :get, local: true, data: { turbo: false, controller: 'flight-search flight-history', action: 'submit->flight-search#validateForm submit->flight-history#saveSearch' } do |f| %>
        <%= f.hidden_field :departure_city, value: params[:departure_city] || '北京', data: { 'city-selector-target': 'departureCityInput', 'flight-search-target': 'departureInput' } %>
        <%= f.hidden_field :destination_city, value: params[:destination_city] || '杭州', data: { 'city-selector-target': 'destinationCityInput', 'flight-search-target': 'destinationInput' } %>
        <%= f.hidden_field :date, value: Time.zone.today, data: { 'date-picker-target': 'dateInput' } %>
        <%= f.hidden_field :return_date, value: '', data: { 'trip_type_target': 'returnDateInput', 'return_date_picker_target': 'dateInput' } %>
        <%= f.hidden_field :trip_type, value: 'one_way', data: { 'trip-type-target': 'tripTypeInput' } %>
        <%= f.hidden_field :cabin_class, value: params[:cabin_class] || 'all', data: { 'cabin_selector_target': 'hiddenInput' } %>
        <button type="submit" class="w-full py-4 rounded-full text-lg font-bold text-back my-2" style="background: #FFD700;">
          搜索机票
        </button>
      <% end %>

      <!-- Search History Section -->
      <div class="mt-4" data-controller="flight-history" data-flight-history-target="container">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-medium text-gray-600">历史搜索</h3>
          <button 
            type="button"
            data-action="click->flight-history#clearHistory"
            class="text-xs text-blue-500 hover:text-blue-700">
            清空记录
          </button>
        </div>
        <div class="flex gap-3 overflow-x-auto no-scrollbar" data-flight-history-target="list">
          <!-- History items will be rendered dynamically -->
        </div>
      </div>
    </div>

    <!-- Multi-City Form (hidden by default) -->
    <div class="mx-4 mb-4 hidden" data-trip-type-target="multiCityForm">
      <!-- Multi-City Segments Container -->
      <div data-multi-city-target="segmentsContainer">
        <!-- Segments will be rendered dynamically by the controller -->
      </div>

      <!-- Add Segment Button -->
      <button 
        type="button"
        data-action="click->multi-city#addSegment"
        data-multi-city-target="addButton"
        class="w-full py-3 border-2 border-dashed border-gray-300 rounded-lg text-gray-600 hover:border-blue-500 hover:text-blue-500 transition-colors flex items-center justify-center gap-2 my-4">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
        </svg>
        <span class="text-base font-medium">再加一程</span>
      </button>

      <!-- Passenger Selection -->
      <button 
        type="button"
        data-action="click->passenger-selector#openModal"
        class="w-full flex items-center justify-between py-3 border-b border-gray-100">
        <div data-passenger-selector-target="selectedDisplay">
          <div class="text-base text-gray-800">选择乘机人</div>
          <div class="text-sm" style="color: #00A0E9;">快速找到低价票</div>
        </div>
        <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
      </button>

      <!-- Cabin Class Selection -->
      <div class="w-full flex mt-4">
        <div class="flex gap-1 rounded-sm bg-gray-950/5 px-1 py-1 w-full">
          <button 
            type="button"
            data-cabin-selector-target="button"
            data-cabin-type="all"
            data-action="click->cabin-selector#select"
            class="flex-1 px-4 py-2 rounded-sm text-sm font-medium transition-colors">
            全部舱位
          </button>
          <button 
            type="button"
            data-cabin-selector-target="button"
            data-cabin-type="business"
            data-action="click->cabin-selector#select"
            class="flex-1 px-4 py-2 rounded-sm text-sm font-medium transition-colors whitespace-nowrap">
            公务/头等舱
          </button>
        </div>
      </div>

      <!-- Search Button for Multi-City -->
      <%= form_with url: multi_city_search_flights_path, method: :get, local: true, data: { turbo: false } do |f| %>
        <%= f.hidden_field :trip_type, value: 'multi_city', data: { 'trip-type-target': 'tripTypeInput' } %>
        <%= f.hidden_field :segments, value: '', data: { 'multi-city-target': 'hiddenSegmentsInput' } %>
        <%= f.hidden_field :cabin_class, value: params[:cabin_class] || 'all', data: { 'cabin_selector_target': 'hiddenInput' } %>
        <button type="submit" class="w-full py-4 rounded-full text-lg font-bold text-black my-2" style="background: #FFD700;">
          搜索机票
        </button>
      <% end %>
    </div>

    </div>
  </div>

  
  <!-- Quick Links -->
  <div class="mx-4 mt-4 bg-white rounded-2xl pt-[3px] pb-[18px] shadow-sm">
    <div class="grid grid-cols-5 items-center">
      <%= link_to special_flights_path, class: "flex flex-1 flex-col items-center gap-1.5" do %>
        <%= image_tag "airfare/特价机票.png", class: "w-full h-auto", alt: "特价机票" %>
      <% end %>

      <div class="flex flex-1 flex-col items-center gap-1.5 relative">
        <%= link_to flight_packages_path do %>
          <%= image_tag "airfare/机票次卡.png", class: "w-full h-auto", alt: "机票次卡" %>
        <% end %>
      </div>

      <div class="flex flex-1 flex-col items-center gap-1.5">
        <%= link_to price_alerts_path do %>
          <%= image_tag "airfare/低价提醒.png", class: "w-full h-auto", alt: "低价提醒" %>
        <% end %>
      </div>

      <div class="flex flex-1 flex-col items-center gap-1.5">
        <%= link_to family_benefits_path do %>
          <%= image_tag "airfare/家庭认证.png", class: "w-full h-auto", alt: "家庭认证" %>
        <% end %>
      </div>

      <div class="flex flex-1 flex-col items-center gap-1.5">
        <%= image_tag "airfare/展开全部.png", class: "w-full h-auto", alt: "展开全部" %>
      </div>
    </div>
  </div>

  <!-- Promotion Section -->
  <div class="bg-[#F8F9FA] py-4 mt-4">
    <div class="mx-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-1">
          <span class="bg-[#FF4D4F] text-white text-[10px] px-1.5 py-0.5 rounded-sm font-bold leading-none">新人专享</span>
          <span class="text-[15px] font-bold text-[#333333] ml-1">找优惠 省钱专区</span>
        </div>
        <button class="text-[13px] text-gray-500 flex items-center">更多优惠 <span class="ml-0.5 text-[10px] mt-0.5">›</span></button>
      </div>

      <!-- Offer Cards -->
      <div class="grid grid-cols-3 gap-2">
        <div class="bg-white rounded-xl p-3 relative overflow-hidden">
          <div class="text-[13px] font-bold text-[#333333] mb-0.5 relative z-10">机票卡低价团</div>
          <div class="text-[11px] text-gray-500 mb-3 relative z-10">66元飞全球</div>
          <button class="w-full py-1 text-[11px] font-bold rounded-full relative z-10" style="background: #FFF9F3; color: #FF7A45; border: 1px solid #FFE7D6;">立即抢购</button>
          <div class="absolute -bottom-1 -right-1 opacity-10">
            <%= image_tag "airfare/机票次卡.png", class: "w-12 h-12 rotate-[-15deg]" %>
          </div>
        </div>

        <div class="bg-white rounded-xl p-3 relative overflow-hidden">
          <div class="text-[13px] font-bold text-[#333333] mb-0.5 relative z-10">请3休8过元旦</div>
          <div class="text-[11px] text-gray-500 mb-3 relative z-10">领至高255元券包</div>
          <button class="w-full py-1 text-[11px] font-bold rounded-full relative z-10" style="background: #FFF9F3; color: #FF7A45; border: 1px solid #FFE7D6;">立即领取</button>
          <div class="absolute bottom-2 right-2 text-[#FF4D4F] opacity-10 text-4xl font-bold italic">¥</div>
        </div>

        <div class="bg-white rounded-xl p-3 relative overflow-hidden">
          <div class="text-[13px] font-bold text-[#333333] mb-0.5 relative z-10">飞5送1</div>
          <div class="text-[11px] text-gray-500 mb-3 relative z-10">满5单兑换</div>
          <button class="w-full py-1 text-[11px] font-bold rounded-full relative z-10" style="background: #FFF9F3; color: #FF7A45; border: 1px solid #FFE7D6;">立即参与</button>
          <div class="absolute -bottom-1 -right-1 opacity-10">
            <%= image_tag "airfare/特价机票.png", class: "w-12 h-12 rotate-[-15deg]" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Special Offers Section -->
  <div class="bg-white pt-5 pb-8 rounded-t-3xl -mt-4 relative z-10">
    <div class="mx-4">
      <div class="flex items-center justify-between mb-4">
        <%= link_to search_flights_path(sort_by: 'price', departure_city: '深圳', destination_city: '杭州', date: (Time.zone.today + 7.days).to_s, trip_type: 'one_way'), class: "text-lg font-bold text-[#333333]" do %>
          特价机票
        <% end %>
        <%= link_to search_flights_path(sort_by: 'price', departure_city: '深圳', destination_city: '杭州', date: (Time.zone.today + 7.days).to_s, trip_type: 'one_way'), class: "text-[13px] text-gray-500 flex items-center" do %>
          更多 <span class="ml-0.5 text-[10px] mt-0.5">›</span>
        <% end %>
      </div>

      <!-- Offer Tabs -->
      <div class="flex gap-2 mb-5 overflow-x-auto no-scrollbar items-center">
        <button class="px-3 py-2 rounded-full text-[13px] font-bold whitespace-nowrap flex items-center gap-1" style="background: #FFF9F3; color: #333333;">
          <span class="text-orange-400">👍</span> 精选特价推荐
        </button>
        <button class="px-3 py-2 rounded-full text-[13px] text-gray-600 whitespace-nowrap flex items-center gap-1 bg-white border border-transparent">
          <span class="opacity-70">💯</span> 百元任意飞
        </button>
        <button class="px-3 py-2 rounded-full text-[13px] text-gray-600 whitespace-nowrap flex items-center gap-1 bg-white border border-transparent">
          <span class="opacity-70">✈️</span> 航司特价
        </button>
      </div>

      <!-- Flight Deals List -->
      <div class="space-y-5">
        <!-- Deal 1 -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <img src="https://images.unsplash.com/photo-1564221710304-0b37c8b9d729?w=200&h=200&fit=crop" class="w-[72px] h-[72px] rounded-xl object-cover" alt="北京">
            <div>
              <div class="font-bold text-[15px] text-[#333333] mb-1">北京 - 杭州</div>
              <div class="text-[11px] text-gray-400">12.23 周二</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-[#FF4D4F] font-bold leading-tight">
              <span class="text-sm">¥</span><span class="text-2xl">256</span>
            </div>
            <div class="inline-block text-[10px] text-[#FF4D4F] bg-[#FFF1F0] px-1.5 py-0.5 rounded-sm mt-1">超低1.1折</div>
          </div>
        </div>

        <!-- Deal 2 -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <img src="https://images.unsplash.com/photo-1559564484-e48bb92e6e83?w=200&h=200&fit=crop" class="w-[72px] h-[72px] rounded-xl object-cover" alt="上海">
            <div>
              <div class="font-bold text-[15px] text-[#333333] mb-1">北京 - 上海</div>
              <div class="text-[11px] text-gray-400">12.17 周三</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-[#FF4D4F] font-bold leading-tight">
              <span class="text-sm">¥</span><span class="text-2xl">300</span>
            </div>
            <div class="inline-block text-[10px] text-[#FF4D4F] bg-[#FFF1F0] px-1.5 py-0.5 rounded-sm mt-1">超低1.7折</div>
          </div>
        </div>

        <!-- Deal 3 -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <img src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=200&h=200&fit=crop" class="w-[72px] h-[72px] rounded-xl object-cover" alt="深圳">
            <div>
              <div class="font-bold text-[15px] text-[#333333] mb-1">深圳 - 杭州</div>
              <div class="text-[11px] text-gray-400">12.15 周一</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-[#FF4D4F] font-bold leading-tight">
              <span class="text-sm">¥</span><span class="text-2xl">230</span>
            </div>
            <div class="inline-block text-[10px] text-[#FF4D4F] bg-[#FFF1F0] px-1.5 py-0.5 rounded-sm mt-1">超低1.4折</div>
          </div>
        </div>

        <!-- Deal 4 - Multi-city Pass -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="relative">
              <img src="https://images.unsplash.com/photo-1503423571797-2d2bb372094a?w=200&h=200&fit=crop" class="w-[72px] h-[72px] rounded-xl object-cover" alt="深圳出发">
              <div class="absolute top-0 left-0 bg-[#FF7A45] text-white text-[9px] px-1.5 py-0.5 rounded-tl-xl rounded-br-lg font-bold leading-none">机票卡</div>
            </div>
            <div>
              <div class="font-bold text-[15px] text-[#333333] mb-1">深圳出发 可飞2城</div>
              <div class="text-[11px] text-gray-400">10.10~03.28可选</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-[11px] text-gray-500 mb-0.5">人均单次<span class="text-[#FF4D4F] font-bold ml-0.5">¥398</span></div>
            <div class="text-[#FF4D4F] leading-tight">
              <span class="text-[11px] font-bold">总价</span><span class="text-sm font-bold">¥</span><span class="text-2xl font-bold">2388</span>
            </div>
          </div>
        </div>

        <!-- Deal 5 - Domestic Pass -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="relative">
              <img src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=200&h=200&fit=crop" class="w-[72px] h-[72px] rounded-xl object-cover" alt="国内盲盒卡">
              <div class="absolute top-0 left-0 bg-[#FF7A45] text-white text-[9px] px-1.5 py-0.5 rounded-tl-xl rounded-br-lg font-bold leading-none">机票卡</div>
            </div>
            <div>
              <div class="font-bold text-[15px] text-[#333333] mb-1">特价机票国内盲盒卡</div>
              <div class="text-[11px] text-gray-400">日期灵活 不约可退</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-[#FF4D4F] font-bold leading-tight">
              <span class="text-sm">¥</span><span class="text-2xl">199</span>
            </div>
            <div class="text-[10px] text-[#FF4D4F] font-bold mt-1">单次低至</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Spacing -->
  <div class="h-20"></div>

  <!-- Bottom Navigation -->
  <div class="fixed bottom-0 left-0 right-0  mx-auto bg-white border-t border-gray-200 z-50">
    <div class="grid grid-cols-5 px-2 py-2">
      <button class="flex flex-col items-center justify-center gap-1.5" onclick="window.showToast('精彩即将上线，敬请期待')">
        <%= image_tag "airfare/我的收藏.png", class: "w-6 h-6", alt: "我的收藏" %>
        <span class="text-[11px] text-gray-700">我的收藏</span>
      </button>

      <button class="flex flex-col items-center justify-center gap-1.5" onclick="window.showToast('精彩即将上线，敬请期待')">
        <%= image_tag "airfare/航班动态.png", class: "w-6 h-6", alt: "航班动态" %>
        <span class="text-[11px] text-gray-700">航班动态</span>
      </button>

      <button class="flex flex-col items-center justify-center gap-1.5" onclick="window.showToast('精彩即将上线，敬请期待')">
        <%= image_tag "airfare/值机选座.png", class: "w-6 h-6", alt: "值机选座" %>
        <span class="text-[11px] text-gray-700">值机选座</span>
      </button>

      <button class="flex flex-col items-center justify-center gap-1.5" onclick="window.showToast('精彩即将上线，敬请期待')">
        <%= image_tag "airfare/发票报销.png", class: "w-6 h-6", alt: "发票报销" %>
        <span class="text-[11px] text-gray-700">发票报销</span>
      </button>

      <%= link_to bookings_path, class: "flex flex-col items-center justify-center gap-1.5" do %>
        <%= image_tag "airfare/我的订单.png", class: "w-6 h-6", alt: "我的订单" %>
        <span class="text-[11px] text-gray-700">我的订单</span>
      <% end %>
    </div>
  </div>

  <!-- City Selector Modal -->
  <%= render 'shared/city_selector_modal' %>
  
  <!-- Date Picker Modal -->
  <%= render 'shared/date_picker_modal' %>
  
  <!-- Return Date Picker Modal -->
  <%= render 'shared/return_date_picker_modal' %>
  
  <!-- Passenger Selector Modal -->
  <%= render 'shared/passenger_selector_modal' %>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translate(-50%, -40%);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
  }
  
  @keyframes fadeOut {
    from {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
    to {
      opacity: 0;
      transform: translate(-50%, -60%);
    }
  }
  
  .animate-fade-in {
    animation: fadeIn 0.3s ease-out;
  }
  
  .animate-fade-out {
    animation: fadeOut 0.3s ease-out;
  }
</style>
