<div class="mx-auto bg-white min-h-screen pb-20">
  
  <!-- Fixed Header -->
  <div class="fixed top-0 left-0 right-0 mx-auto z-50 bg-white border-b border-gray-100">
    <div class="flex items-center px-4 py-3">
      <%= link_to hotels_hotel_package_path(@package), class: "mr-3" do %>
        <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      <% end %>
      <div class="flex-1">
        <h1 class="text-base font-bold">可预约酒店</h1>
        <p class="text-xs text-gray-500"><%= @package.brand_name %> · <%= @package.city %></p>
      </div>
    </div>
  </div>

  <!-- Content with top padding to clear fixed header -->
  <div class="pt-16">
    <!-- Package Info Banner -->
    <div class="mx-4 mt-3 mb-4 p-3 rounded-lg" style="background: linear-gradient(135deg, #FFF8E1 0%, #FFE082 100%);">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-800"><%= @package.title %></p>
          <p class="text-xs text-gray-600 mt-1">¥<%= @package.price.to_i %>起 · <%= @package.night_count %>晚可拆分</p>
        </div>
        <%= link_to "查看套餐详情 >", hotel_package_path(@package), class: "text-xs text-orange-600 font-medium" %>
      </div>
    </div>

    <!-- Hotels List -->
    <div class="px-4">
      <% if @hotels.any? %>
        <div class="mb-3">
          <p class="text-sm text-gray-600">找到 <span class="font-bold text-gray-900"><%= @hotels.count %></span> 家可预约酒店</p>
        </div>

        <div class="space-y-3">
          <% @hotels.each do |hotel| %>
            <%= link_to hotel_path(hotel), class: "block" do %>
              <div class="bg-white rounded-lg overflow-hidden border border-gray-100 shadow-sm">
                <div class="flex">
                  <!-- Hotel Image -->
                  <div class="relative w-28 h-28 flex-shrink-0">
                    <% if hotel.image_url.present? %>
                      <%= image_tag hotel.image_url, class: "w-full h-full object-cover", alt: hotel.name %>
                    <% else %>
                      <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                        <svg class="w-12 h-12 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                        </svg>
                      </div>
                    <% end %>
                  </div>

                  <!-- Hotel Info -->
                  <div class="flex-1 p-3">
                    <div class="flex items-start justify-between mb-1">
                      <h3 class="text-sm font-bold line-clamp-1 flex-1"><%= hotel.name %></h3>
                      <% if hotel.star_level.present? %>
                        <span class="ml-2 text-xs text-yellow-600 flex-shrink-0">
                          <%= "★" * hotel.star_level.to_i %>
                        </span>
                      <% end %>
                    </div>

                    <!-- Rating -->
                    <% if hotel.rating.present? %>
                      <div class="flex items-center gap-1 mb-1">
                        <span class="text-sm font-bold text-blue-600"><%= hotel.rating %></span>
                        <span class="text-xs text-gray-500">
                          <%= case hotel.rating.to_f
                              when 4.8..5.0 then "超棒"
                              when 4.5..4.7 then "很好"
                              when 4.0..4.4 then "不错"
                              else "一般"
                              end %>
                        </span>
                      </div>
                    <% end %>

                    <!-- Address -->
                    <div class="flex items-center gap-1 text-xs text-gray-500 mb-2">
                      <svg class="w-3 h-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                      </svg>
                      <span class="line-clamp-1"><%= hotel.address || "#{hotel.city} #{hotel.district}" %></span>
                    </div>

                    <!-- Price -->
                    <div class="flex items-baseline gap-1">
                      <span class="text-xs text-orange-600">¥</span>
                      <span class="text-lg font-bold text-orange-600"><%= hotel.price.to_i %></span>
                      <span class="text-xs text-gray-400">起</span>
                    </div>
                  </div>
                </div>

                <!-- Bottom Tags -->
                <div class="px-3 pb-3 flex gap-1.5 flex-wrap">
                  <span class="px-2 py-0.5 text-xs rounded bg-orange-50 text-orange-600 border border-orange-200">套餐可用</span>
                  <% if hotel.has_parking %>
                    <span class="px-2 py-0.5 text-xs rounded bg-gray-100 text-gray-600">停车场</span>
                  <% end %>
                  <% if hotel.has_pool %>
                    <span class="px-2 py-0.5 text-xs rounded bg-gray-100 text-gray-600">游泳池</span>
                  <% end %>
                  <% if hotel.has_gym %>
                    <span class="px-2 py-0.5 text-xs rounded bg-gray-100 text-gray-600">健身房</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="text-center py-16 px-6">
          <div class="w-20 h-20 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center">
            <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <p class="text-lg font-medium text-gray-700 mb-2">暂无可预约的酒店</p>
          <p class="text-sm text-gray-500 mb-4">
            当前套餐暂未关联可用酒店，<br>
            请联系客服或选择其他套餐
          </p>
          <%= link_to "返回套餐详情", hotel_package_path(@package), class: "inline-block px-6 py-2.5 rounded-full text-sm font-medium text-white", style: "background: linear-gradient(135deg, #FFD700 0%, #FFC700 100%);" %>
        </div>
      <% end %>
    </div>

    <!-- Tips Section -->
    <% if @hotels.any? %>
      <div class="mx-4 mt-6 p-4 bg-blue-50 rounded-lg">
        <div class="flex items-start gap-2">
          <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <div class="flex-1">
            <p class="text-sm font-medium text-blue-900 mb-1">预约提示</p>
            <ul class="text-xs text-blue-700 space-y-1">
              <li>• 此套餐可在以上酒店使用</li>
              <li>• 需提前1天预约，以酒店确认为准</li>
              <li>• 不同日期价格可能有差异</li>
              <li>• 建议提前预约以确保房源</li>
            </ul>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
